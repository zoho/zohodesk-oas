            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of timers to fetch. Defaults to 20 if not provided.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 50
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which timers must be fetched. Defaults to 0 if not provided.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getActiveTimerForAgents"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.tickets.READ" ]
        } ]
      }
