    "/api/v1/validationRules" : {
      "get" : {
        "tags" : [ "ValidationRules" ],
        "summary" : "Get Layout Validation Rules for Department or Layout",
        "description" : "Retrieves all validation rules configured for a department or layout, with pagination support.",
        "operationId" : "getValidationRules",
        "parameters" : [ {
          "name" : "activeLayouts",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string" ],
            "pattern" : "true|false",
            "maxLength" : 100,
            "enum" : [ "true", "false" ]
          },
          "style" : "form",
          "explode" : true,
          "description" : "Indicates whether only validation rules from active layouts must be returned. Possible values: true = returns rules from active layouts only; false = returns rules from all applicable layouts"
        }, {
          "name" : "activeRules",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string" ],
            "pattern" : "true|false",
            "maxLength" : 100,
            "enum" : [ "true", "false" ]
          },
          "style" : "form",
          "explode" : true,
          "description" : "Indicates whether only active validation rules must be returned. Possible values: true = returns only active validation rules; false = returns all applicable validation rules"
        }, {
          "name" : "include",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "enum" : [ "creator", "modifier" ]
            },
            "maxItems" : 2
          },
          "style" : "form",
          "explode" : false,
          "description" : "Additional information related to the rules. Possible values: creator, modifier"
        }, {
          "name" : "searchString",
          "in" : "query",
          "description" : "Search term used to filter validation rules",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "name" : "executeInHelpCentre",
          "in" : "query",
          "description" : "Indicates whether only validation rules executable in Help Centre must be returned. Possible values: true = returns validation rules executable in Help Centre; false = returns validation rules regardless of Help Centre execution",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "pattern" : "true|false",
            "maxLength" : 100,
            "enum" : [ "true", "false" ]
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department whose validation rules must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "maxLength" : 100
          }
        }, {
          "name" : "module",
          "in" : "query",
          "description" : "Name of the module for which validation rules must be fetched. Standard values: tickets, contacts, accounts, tasks, timeEntry, contracts, products, calls, events. Custom modules are also supported.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "examples" : [ "tickets", "contacts", "contracts", "accounts", "products", "timeEntry", "tasks", "calls", "events" ],
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+",
            "maxLength" : 100
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of validation rules to fetch",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 50,
            "default" : 50
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which the validation rules must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 0,
            "default" : 0
          }
        }, {
          "name" : "layoutId",
          "in" : "query",
          "description" : "Unique ID of the layout whose validation rules must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "maxLength" : 100
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "x-dependent-required" : [ {
          "if" : {
            "not" : {
              "required" : [ "module" ]
            }
          },
          "then" : {
            "required" : [ "layoutId" ]
          }
        }, {
          "if" : {
            "not" : {
              "required" : [ "layoutId" ]
            }
          },
          "then" : {
            "required" : [ "module" ]
          }
        } ],
        "responses" : {
          "400" : {
            "$ref" : "#/components/responses/validationRuleBadRequestResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/unprocessableEntityErrorResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/validationRuleListArray"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.layouts.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.settings.READ" ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "conditions" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "displayValue" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "maxLength" : 1000,
              "minLength" : 0
            },
            "maxItems" : 50,
            "uniqueItems" : false,
            "description" : "Display value(s) used for the condition"
          },
          "displayLabel" : {
            "type" : [ "string" ],
            "maxLength" : 250,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "Display label of the field used in the condition"
          },
          "condition" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "Operator used for the condition. Valid operators depend on the field type: text, picklist, and lookup support is, isn't, starts with, contains, doesn't contain, ends with, is empty, is not empty; date supports is, isn't, is after, is before, is empty, is not empty; dateTime additionally supports between and not between; integer and currency support =, <>, <, <=, >, >=, is empty, is not empty; boolean supports is. Call Get Criteria Fields for Validation Rules to get the exact operators allowed for a specific field."
          },
          "fieldName" : {
            "type" : [ "string" ],
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "API name of a module field used in the condition. The field must exist on the module. For lookups, use the flat field API name."
          },
          "value" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "maxLength" : 1000,
              "minLength" : 0
            },
            "maxItems" : 50,
            "uniqueItems" : false,
            "description" : "Value(s) used for the condition. For lookup fields, pass the related record display name, not the record ID. For is empty and is not empty, the value is the ${EMPTY} or ${NOTEMPTY} token. dateTime conditions may use ${CURRENTTIME} in place of a timestamp. Boolean fields use true or false."
          }
        },
        "required" : [ "condition", "fieldName", "value" ]
      },
      "conditionsArr" : {
        "type" : [ "array" ],
        "items" : {
          "$ref" : "#/components/schemas/conditions"
        },
        "maxItems" : 1000
      },
      "actions" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "alert" : {
            "type" : [ "string" ],
            "maxLength" : 200,
            "minLength" : 0,
            "description" : "Alert message shown when the condition block matches"
          }
        },
        "required" : [ "alert" ]
      },
      "fieldConditions" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "pattern" : {
            "type" : [ "string" ],
            "maxLength" : 250,
            "minLength" : 0,
            "pattern" : "[andor()0-9\\s]*",
            "description" : "Expression that combines this branch's conditions by index (1 is the first condition). Criterion 1 must be ANDed at the root -- for example (1 and 2) or (1 and (2 or 3)). A single condition may be just 1. Root OR patterns such as (1 or 2) are invalid; use multiple fieldConditions branches instead."
          },
          "name" : {
            "type" : [ "string" ],
            "maxLength" : 250,
            "minLength" : 0,
            "description" : "Name of the field condition block"
          },
          "conditions" : {
            "$ref" : "#/components/schemas/conditionsArr",
            "description" : "Conditions in this branch. The first condition must use the rule primary field (fieldName)."
          },
          "actions" : {
            "$ref" : "#/components/schemas/actions",
            "description" : "Actions executed when the condition block matches"
          }
        },
        "required" : [ "actions", "conditions", "name", "pattern" ]
      },
      "fieldConditionsArr" : {
        "type" : [ "array" ],
        "items" : {
          "$ref" : "#/components/schemas/fieldConditions"
        },
        "maxItems" : 1000
      },
      "conditionsRequest" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "condition" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "Operator used for the condition. Valid operators depend on the field type: text, picklist, and lookup support is, isn't, starts with, contains, doesn't contain, ends with, is empty, is not empty; date supports is, isn't, is after, is before, is empty, is not empty; dateTime additionally supports between and not between; integer and currency support =, <>, <, <=, >, >=, is empty, is not empty; boolean supports is. Call Get Criteria Fields for Validation Rules to get the exact operators allowed for a specific field."
          },
          "fieldName" : {
            "type" : [ "string" ],
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "API name of a module field used in the condition. The field must exist on the module. For lookups, use the flat field API name."
          },
          "value" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "maxLength" : 1000,
              "minLength" : 0
            },
            "maxItems" : 50,
            "uniqueItems" : false,
            "description" : "Value(s) used for the condition. For lookup fields, pass the related record display name, not the record ID. For is empty and is not empty, the value is the ${EMPTY} or ${NOTEMPTY} token. dateTime conditions may use ${CURRENTTIME} in place of a timestamp. Boolean fields use true or false."
          }
        },
        "required" : [ "condition", "fieldName", "value" ]
      },
      "conditionsRequestArr" : {
        "type" : [ "array" ],
        "items" : {
          "$ref" : "#/components/schemas/conditionsRequest"
        },
        "maxItems" : 1000
      },
      "fieldConditionsRequest" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "pattern" : {
            "type" : [ "string" ],
            "maxLength" : 250,
            "minLength" : 0,
            "pattern" : "[andor()0-9\\s]*",
            "description" : "Expression that combines this branch's conditions by index (1 is the first condition). Criterion 1 must be ANDed at the root -- for example (1 and 2) or (1 and (2 or 3)). A single condition may be just 1. Root OR patterns such as (1 or 2) are invalid; use multiple fieldConditions branches instead.",
            "example" : [ "(1 and 2)", "(1 and (2 or 3))" ]
          },
          "name" : {
            "type" : [ "string" ],
            "maxLength" : 250,
            "minLength" : 0,
            "description" : "Name of the field condition block"
          },
          "conditions" : {
            "$ref" : "#/components/schemas/conditionsRequestArr",
            "description" : "Conditions in this branch. The first condition must use the rule primary field (fieldName)."
          },
          "actions" : {
            "$ref" : "#/components/schemas/actions",
            "description" : "Actions executed when the condition block matches"
          }
        },
        "required" : [ "actions", "conditions", "name", "pattern" ]
      },
      "fieldConditionsRequestArr" : {
        "type" : [ "array" ],
        "items" : {
          "$ref" : "#/components/schemas/fieldConditionsRequest"
        },
        "maxItems" : 1000
      },
      "validationRuleRequestSchema" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "fieldName" : {
            "type" : [ "string" ],
            "maxLength" : 255,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "API name of the primary module field for this rule. Every fieldConditions[].conditions[0].fieldName must equal this value."
          },
          "fieldConditions" : {
            "$ref" : "#/components/schemas/fieldConditionsRequestArr",
            "description" : "Independent branch conditions. Each entry is evaluated separately and runs its own actions when matched. Use multiple branches for alternate criterion trees; combine conditions within a branch only via that branch's pattern."
          },
          "displayLabel" : {
            "type" : [ "string" ],
            "description" : "Display Label of the primary field to be used for creating the rule",
            "maxLength" : 250,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+"
          },
          "executeInHelpCentre" : {
            "type" : "boolean",
            "description" : "Indicates whether the validation rule can be executed in Help Centre. Possible values: true = validation rule can be executed in Help Centre; false = validation rule cannot be executed in Help Centre."
          },
          "status" : {
            "type" : [ "string" ],
            "enum" : [ "active", "deactive" ],
            "description" : "Activation status of the validation rule. Possible values: active, deactive."
          }
        },
        "required" : [ "fieldName", "fieldConditions" ]
      },
      "validationRuleActor" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "id" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the user"
          },
          "firstName" : {
            "type" : [ "string", "null" ],
            "maxLength" : 50,
            "minLength" : 0,
            "description" : "First name of the user"
          },
          "lastName" : {
            "type" : [ "string", "null" ],
            "maxLength" : 50,
            "minLength" : 0,
            "description" : "Last name of the user"
          },
          "email" : {
            "type" : [ "string", "null" ],
