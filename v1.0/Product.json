          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "enum" : [ "departments", "owner" ]
            },
            "uniqueItems" : true
          }
        }, {
          "name" : "productId",
