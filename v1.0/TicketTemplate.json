    "/api/v1/ticketTemplates" : {
      "get" : {
        "tags" : [ "TicketTemplate" ],
        "summary" : "List ticket templates",
        "description" : "This API lists a particular number of ticket templates, based on the limit specified.",
        "operationId" : "getTicketTemplates",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "showInCustomerPortal",
          "in" : "query",
          "description" : "Filters templates by help center visibility. Accepted values: true = displayed in the help center, false = not displayed in the help center",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "boolean" ]
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department from which templates must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of templates to fetch. The default value is 10 and the maximum value supported is 100",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "pattern" : "([0-9]+)",
            "default" : 10
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which the templates must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 0,
            "default" : 0
          }
        }, {
          "name" : "layoutId",
          "in" : "query",
          "description" : "Unique ID of the layout from which templates must be fetched for the specified department",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "templateName",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          },
          "style" : "form",
          "explode" : true,
          "description" : "Name of the template",
          "deprecated" : true
        }, {
          "name" : "searchStr",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          },
          "style" : "form",
          "explode" : true,
          "description" : "Search string to filter templates by name"
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/listTicketTemplateResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.READ", "Desk.templates.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      },
