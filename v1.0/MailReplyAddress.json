          },
          "serviceProviderType" : {
            "type" : "string",
            "description" : "Service provider type: ZohoSMTP, CustomSMTP, Outlook, Office, or Google",
            "enum" : [ "ZohoSMTP", "CustomSMTP", "Outlook", "Office", "Google" ]
          },
          "smtpDetails" : {
            "$ref" : "#/components/schemas/smtpDetailsInRequest",
            "description" : "SMTP configuration details for custom SMTP provider"
          },
          "isDepartmentDefault" : {
            "type" : "boolean",
            "description" : "true when this from address is set as the default reply address for the department. A department can have only one default From address at a time."
          },
          "isActive" : {
            "type" : "boolean",
            "description" : "Indicates whether the from address is active"
          },
          "isSmtpEnabled" : {
            "type" : "boolean",
            "description" : "deprecated parameter. Use serviceProviderType instead. true when serviceProviderType is CustomSMTP, false otherwise."
          }
        },
        "if" : {
          "required" : [ "serviceProviderType" ],
          "properties" : {
            "serviceProviderType" : {
              "const" : "CustomSMTP",
              "description" : "Service provider type constant for conditional validation"
            }
          }
        },
        "then" : {
          "required" : [ "smtpDetails" ]
        }
      },
      "fromAddressDetails" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "id" : {
            "type" : "string",
            "description" : "Unique identifier for the From address",
            "pattern" : "([0-9]+)"
          },
          "address" : {
            "type" : "string",
            "description" : "Email address for the From address",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "^(?=.{1,64}@.{4,255}$)[A-Za-z0-9]+([._+&!*'-][A-Za-z0-9]+)*@([A-Za-z0-9]+(-[A-Za-z0-9]+)*\\.)+[A-Za-z]{2,}$"
          },
          "displayName" : {
            "type" : "string",
            "description" : "Display name for the From address",
            "maxLength" : 100,
            "minLength" : 0
          },
          "departmentId" : {
            "type" : "string",
            "description" : "ID of the department to which the From address belongs",
            "pattern" : "([0-9]+)"
          },
          "serviceProviderType" : {
            "type" : "string",
            "description" : "Service provider type: ZohoSMTP, CustomSMTP, Outlook, Office, or Google",
            "enum" : [ "ZohoSMTP", "CustomSMTP", "Outlook", "Office", "Google" ]
          },
          "isVerified" : {
            "type" : "boolean",
            "description" : "Key that returns if the From address is verified or not"
          },
          "isActive" : {
            "type" : "boolean",
            "description" : "Key that returns if the From address is active or not"
          },
          "createdTime" : {
            "type" : "string",
            "description" : "Timestamp when the From address was created, in ISO 8601 format (UTC)",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))"
          },
          "createdBy" : {
            "$ref" : "#/components/schemas/author",
            "description" : "User who created the From address"
          },
          "modifiedTime" : {
            "type" : "string",
            "description" : "Timestamp when the From address was last modified, in ISO 8601 format (UTC)",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))"
          },
          "modifiedBy" : {
            "$ref" : "#/components/schemas/author",
            "description" : "User who last modified the From address"
          },
          "smtpDetails" : {
            "$ref" : "#/components/schemas/smtpDetails",
            "description" : "SMTP configuration details for custom SMTP provider"
          },
          "url" : {
            "type" : "string",
            "description" : "OAuth provider URL for Outlook, Office, or Google providers",
            "pattern" : "^([a-zA-Z0-9-]+(\\.[a-zA-Z0-9-]+)+)(:[0-9]+)?(\\/[^\\s]*)?$"
          },
          "isDepartmentDefault" : {
            "type" : "boolean",
            "description" : "true when this from address is set as the default From address for the department"
          }
        },
        "required" : [ "id", "address", "displayName", "departmentId", "serviceProviderType", "isDepartmentDefault", "isActive", "isVerified", "createdBy", "createdTime", "modifiedBy", "modifiedTime" ]
      },
      "data" : {
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/fromAddressDetails"
        }
      }
    },
