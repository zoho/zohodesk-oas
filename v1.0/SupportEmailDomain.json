            "$ref" : "#/components/responses/getSupportEmailDomainResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      },
      "put" : {
        "tags" : [ "SupportEmailDomain" ],
        "summary" : "Update Support email address domain",
        "description" : "This API updates the domain (the \"~mycompany~\" part) of the support email address.!!1. Only the primary contact of the organization can update the domain of the support email address.!2. The new support email address will be support@zylker.com.!3. The updated support email address will be used for fetching emails, henceforth. So make sure that you update the new address in the forwarding configurations of your mailbox.!4. The new support email address is applicable only for the default department.!5. All existing email aliases along with the old support email address will be permanently deleted from your account.<br/>6. Emails forwarded to the old support address will not be fetched in.",
        "operationId" : "updateSupportEmailAddressDomain",
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/updateSupportEmailPayload"
        },
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/updateSupportEmailDomainResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
