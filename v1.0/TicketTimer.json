{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "TicketTimer",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/allActiveTimers" : {
      "get" : {
        "tags" : [ "TicketTimer" ],
        "summary" : "Get Active Timers",
        "description" : "Retrieves active timers for the specified department, up to the specified limit.",
        "operationId" : "getActiveTimers",
        "x-mcp-group" : [ "Time Tracking" ],
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department from which timers must be fetched",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "module",
          "in" : "query",
          "description" : "Modules from which timers must be fetched. Possible values: Tickets, Tasks, Events, Calls. Multiple values can be provided by separating them with commas. If no value is provided, all modules are considered.",
          "required" : false,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : [ "array" ],
            "maxItems" : 4,
            "items" : {
              "type" : "string",
              "enum" : [ "Tickets", "Tasks", "Events", "Calls" ]
            }
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of timers to fetch. Defaults to 20 if not provided.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 50
          }
        }, {
          "name" : "startTime",
          "in" : "query",
          "description" : "Epoch timestamp in milliseconds from which to fetch the next set of timers. Works in conjunction with the sortBy parameter to determine sort direction. The startTime value of the last timer in a response serves as the starting point for the next API call.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Sorts timers by start time. Possible values: startTime. Prefix the value with a hyphen (-) to sort in descending order. The default sorting order is descending.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "startTime", "-startTime" ],
            "pattern" : "-?(startTime)"
          }
        }, {
          "name" : "owners",
          "in" : "query",
          "description" : "Filters timers by owner. Multiple owner IDs can be provided by separating them with commas.",
          "required" : false,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : [ "array" ],
            "maxItems" : 20,
            "items" : {
              "type" : [ "string", "integer" ],
              "format" : "int64",
              "pattern" : "([0-9]+)"
            },
            "uniqueItems" : false
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getActiveTimers"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.tickets.READ", "Desk.activities.tasks.READ", "Desk.activities.calls.READ", "Desk.activities.events.READ" ]
        } ]
      }
    },
    "/api/v1/tickets/{caseId}/timer" : {
      "get" : {
        "tags" : [ "TicketTimer" ],
        "summary" : "Get Ticket Timer",
        "description" : "Retrieves the elapsed time recorded in the ticket timer along with its current state",
        "operationId" : "getTicketTimer",
        "x-mcp-group" : [ "Time Tracking", "Tickets" ],
        "parameters" : [ {
          "name" : "caseId",
          "in" : "path",
          "description" : "Unique ID of the ticket",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/ticketTimerJson"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.tickets.READ" ]
        } ]
      },
      "post" : {
        "tags" : [ "TicketTimer" ],
        "summary" : "Perform Ticket Timer Actions",
        "description" : "Perform timer-related actions for a ticket, such as start, stop, pause, and resume the timer.",
        "operationId" : "updateTicketTimerState",
        "x-mcp-group" : [ "Time Tracking", "Tickets" ],
        "parameters" : [ {
          "name" : "action",
          "in" : "query",
          "description" : "Action to perform on the timer. Possible values: START, STOP, PAUSE, RESUME",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "START", "STOP", "PAUSE", "RESUME" ]
          }
        }, {
          "name" : "caseId",
          "in" : "path",
          "description" : "Unique ID of the ticket",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/ticketTimerJson"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.tickets.UPDATE" ]
        } ]
      }
    },
