            "format" : "int32",
            "pattern" : "([0-9]+)",
            "description" : "Number of changesets for the action"
          },
          "action" : {
            "$ref" : "./Sandbox.json#/components/schemas/changesetAction",
            "description" : "Action type of the changesets. Possible values: ADD, UPDATE, DELETE"
          }
        },
        "required" : [ "action", "count" ]
