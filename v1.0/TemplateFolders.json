{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "TemplateFolders",
    "description" : "A template folder is a pack of email templates. Template folders help organize and group email templates for easy access and management within the help desk portal.",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/templateFolders" : {
      "get" : {
        "tags" : [ "TemplateFolders" ],
        "summary" : "Get Template Folders",
        "description" : "Retrieves a list of template folders for the specified department, with pagination support.",
        "operationId" : "getTemplateFolders",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department for which template folders must be fetched.",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of template folders to retrieve.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 1000,
            "default" : 1000
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which template folders must be fetched.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 1000,
            "default" : 1
          }
        }, {
          "name" : "include",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "description" : "Possible values: smsTemplatesCount, emailTemplatesCount.",
              "maxLength" : 100,
              "enum" : [ "smsTemplatesCount", "emailTemplatesCount" ]
            },
            "maxItems" : 2
          },
          "style" : "form",
          "explode" : true,
          "description" : "Additional meta information to include in the response. Possible values: smsTemplatesCount, emailTemplatesCount. Multiple values can be provided by separating them with commas."
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/folderListResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.READ", "Desk.templates.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      },
      "post" : {
        "tags" : [ "TemplateFolders" ],
        "summary" : "Create Template Folder",
        "description" : "Creates a new template folder.",
        "operationId" : "addTemplateFolder",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/addTemplateFolder_templateFolderjson"
