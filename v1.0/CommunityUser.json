    "requestBodies" : {
      "updateCommunityUserInfoRequestJSON" : {
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object" ],
              "additionalProperties" : false,
              "properties" : {
                "isModerated" : {
                  "type" : [ "boolean" ],
                  "description" : "Indicates whether the user must be moderated. Possible values: true = Enable moderation for the user, false = Disable moderation for the user."
