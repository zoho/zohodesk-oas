    "/api/v1/layoutRules" : {
      "get" : {
        "tags" : [ "LayoutRules" ],
        "summary" : "Get Layout Rules",
        "description" : "This API lists all the rules configured for a department/layout.",
        "operationId" : "getLayoutRules",
        "parameters" : [ {
          "name" : "activeLayouts",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string" ],
            "pattern" : "true|false"
          },
          "style" : "form",
          "explode" : true,
          "description" : "Get the rules for active layouts"
        }, {
          "name" : "include",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "enum" : [ "creator", "modifier" ]
            },
            "maxItems" : 2
          },
          "style" : "form",
          "explode" : true,
          "description" : "Additional information related to the rules. Values allowed are: creator and modifier."
        }, {
          "name" : "searchString",
          "in" : "query",
          "description" : "Get the rules that have this search term",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "name" : "executeInHelpCentre",
          "in" : "query",
          "description" : "Get the rules that can be executed in help centre",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "pattern" : "true|false"
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Get the rules of the department",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "module",
          "in" : "query",
          "description" : "Name of the module for which you want to fetch the layout rules. Allowed values are tickets, contacts, accounts, tasks, timeEntry, contracts, products, calls, events",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "tickets", "contacts", "accounts", "tasks", "calls", "events", "timeEntry", "products" ],
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of rules to be fetched. Default is 50",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 50,
            "default" : 50
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number, starting from which the rules must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 0,
            "default" : 0
          }
        }, {
          "name" : "layoutId",
          "in" : "query",
          "description" : "Get the rules of the layout",
          "required" : true,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "activeRules",
          "in" : "query",
          "description" : "Get the rules that are active in the layout",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "pattern" : "true|false"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/layoutRuleListArray"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.layouts.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.settings.READ" ]
        } ]
      }
    }
  },
