    "parameters" : {
      "moduleApiName" : {
        "name" : "moduleApiName",
        "in" : "path",
        "description" : "API name of the custom module from which the record is to be retrieved. Must be a custom module only. Custom module API names begin with the prefix cm_ (for example, cm_doctors). Note: To retrieve the list of available custom modules and their API names, call the Get Modules API.",
        "required" : true,
        "style" : "simple",
        "explode" : false,
        "schema" : {
          "type" : [ "string" ],
          "maxLength" : 100,
          "minLength" : 0,
          "pattern" : "(cm_[a-zA-Z0-9_]+)"
        }
      },
      "recordId" : {
        "name" : "recordId",
        "in" : "path",
        "description" : "ID of the record to retrieve",
        "required" : true,
        "style" : "simple",
        "explode" : false,
        "schema" : {
          "type" : [ "string", "integer" ],
          "format" : "int64",
          "pattern" : "([0-9]+)"
        }
      }
    },
    "requestBodies" : {
      "createRecordPayload" : {
        "description" : "Request body for creating a record. If moduleApiName refers to a department-specific module, the department field is required. If it refers to an org-specific module, department is not applicable and should be omitted.",
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object" ],
              "additionalProperties" : false,
              "properties" : {
                "name" : {
                  "$ref" : "#/components/schemas/nameField"
                },
                "layout" : {
                  "$ref" : "#/components/schemas/layoutInput"
                },
                "owner" : {
                  "$ref" : "#/components/schemas/ownerInput"
                },
                "cf" : {
                  "$ref" : "#/components/schemas/cfInput"
                },
                "department" : {
                  "$ref" : "#/components/schemas/departmentInput"
                }
              },
              "required" : [ "name" ]
            },
            "examples" : {
              "Department-specific module" : {
                "summary" : "Create record in a department-specific module (department is mandatory)",
                "value" : {
                  "name" : "Doctor 1",
                  "layout" : {
                    "id" : "1000003000004"
                  },
                  "owner" : {
                    "id" : "1000000000375"
                  },
                  "cf" : {
                    "cf_doctor_description" : "Doctor 1 description"
                  },
                  "department" : {
                    "id" : "1000000025632"
                  }
                }
              },
              "Org-specific module" : {
                "summary" : "Create record in an org-specific module (department is not applicable)",
                "value" : {
                  "name" : "Doctor 1",
                  "layout" : {
                    "id" : "1000003000004"
                  },
                  "owner" : {
                    "id" : "1000000000375"
                  },
                  "cf" : {
                    "cf_doctor_description" : "Doctor 1 description"
                  }
                }
              }
            }
          }
        }
      },
      "editRecordPayload" : {
        "description" : "Request body for updating a record. If moduleApiName refers to a department-specific module, the department field is accepted for reassignment. If it refers to an org-specific module, department is not applicable and should be omitted.",
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "null", "object" ],
              "additionalProperties" : false,
              "properties" : {
                "name" : {
                  "$ref" : "#/components/schemas/nameField"
                },
                "layout" : {
                  "$ref" : "#/components/schemas/layoutInput"
                },
                "owner" : {
                  "$ref" : "#/components/schemas/ownerInput"
                },
                "cf" : {
                  "$ref" : "#/components/schemas/cfInput"
                },
                "department" : {
                  "$ref" : "#/components/schemas/departmentInput",
                  "description" : "Department to associate with the record."
                }
              }
            },
            "examples" : {
              "Department-specific module" : {
                "summary" : "Update record in a department-specific module (department can be reassigned)",
                "value" : {
                  "name" : "Doctor 1",
                  "layout" : {
                    "id" : "1000003000004"
                  },
                  "owner" : {
                    "id" : "1000000000375"
                  },
                  "cf" : {
                    "cf_doctor_description" : "Doctor 1 description change"
                  },
                  "department" : {
                    "id" : "1000000025632"
                  }
                }
              },
              "Org-specific module" : {
                "summary" : "Update record in an org-specific module (department is not applicable)",
                "value" : {
                  "name" : "Doctor 1",
                  "cf" : {
                    "cf_doctor_description" : "Doctor 1 description change"
                  }
                }
              }
            }
          }
        }
      },
      "updateManyPayload" : {
        "description" : "Request body for updating a single field across multiple records simultaneously.",
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object" ],
              "additionalProperties" : false,
              "properties" : {
                "fieldName" : {
                  "type" : [ "string" ],
                  "description" : "Name of the field to update",
                  "maxLength" : 320,
                  "minLength" : 0,
                  "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+"
                },
                "ids" : {
                  "description" : "ID(s) of the record(s) to update. Note: A maximum of 50 IDs can be provided as comma-separated values",
                  "$ref" : "#/components/schemas/recordIdsArray"
                },
                "fieldValue" : {
                  "type" : [ "string" ],
                  "description" : "New value for the specified field",
