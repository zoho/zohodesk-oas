            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))"
          },
          "updatedBy" : {
            "description" : "ID of the user who last updated the domain",
            "type" : [ "string", "null" ],
            "pattern" : "([0-9]+)"
          },
          "supportEmailDomain" : {
            "description" : "New support email domain name",
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "oldDomain" : {
            "description" : "Previous support email domain name",
