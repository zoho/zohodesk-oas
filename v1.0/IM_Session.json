          "in" : "query",
          "description" : "Status filter for the conversations. Allowed values: OPEN, ENDED, ON_PROGRESS, ON_HOLD, BLOCKED",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Status filter for the conversations. Allowed values: OPEN, ENDED, ON_PROGRESS, ON_HOLD, BLOCKED",
            "pattern" : "^(OPEN|ENDED|ON_PROGRESS|ON_HOLD|BLOCKED)(,(OPEN|ENDED|ON_PROGRESS|ON_HOLD|BLOCKED)){0,4}$",
            "example" : "OPEN,ENDED,ON_PROGRESS,ON_HOLD,BLOCKED",
