  "paths" : {
    "/api/v1/mailReplyAddress/{mailReplyAddressId}/sendVerification" : {
      "post" : {
        "tags" : [ "MailReplyAddress" ],
        "summary" : "Send verification mail",
        "description" : "This API sends a verification link to the From address configured in your help desk portal.",
        "operationId" : "sendVerificationEmail",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "mailReplyAddressId",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "description" : "Unique ID of the From address",
          "schema" : {
            "type" : "string",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.CREATE", "Desk.basic.CREATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/mailReplyAddress" : {
      "get" : {
        "tags" : [ "MailReplyAddress" ],
        "summary" : "List From addresses",
        "description" : "This API lists the From addresses configured in your help desk portal.",
        "operationId" : "getReplyMailAddresses",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "query",
          "description" : "ID of the department from which the addresses need to be queried. To fetch the addresses from all departments, use 'allDepartment' as the value.",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "allDepartment|[0-9]+"
          }
        }, {
          "name" : "isActive",
          "in" : "query",
          "description" : "Used to filter the mail addresses based on whether they are active or not",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "boolean" ]
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Starting index for fetching the mail addresses. The default value is 1",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "default" : 1,
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Maximum number of mail addresses to fetch. The default value is 50 and the maximum allowed value is 100.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "integer",
            "default" : 50,
            "format" : "int32",
            "minimum" : 1,
            "maximum" : 100
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getReplyMailAddressesResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.READ", "Desk.basic.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      },
      "post" : {
        "tags" : [ "MailReplyAddress" ],
        "summary" : "Add a new From address",
        "description" : "This API adds a new From address to the specified department.",
        "operationId" : "addFromAddress",
        "x-mcp-ready" : true,
        "requestBody" : {
          "$ref" : "#/components/requestBodies/addFromAddressJSON"
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "400" : {
            "$ref" : "./Common.json#/components/responses/badRequestErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/fromAddressResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.CREATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
