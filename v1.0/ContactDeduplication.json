          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.contacts.READ" ]
        } ]
      },
      "post" : {
        "tags" : [ "ContactDeduplication" ],
        "summary" : "Update Default Deduplication Field",
        "description" : "Updates the default field used for contact deduplication.",
        "operationId" : "setDefaultFieldNameForContactDeduplication",
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/setDefaultField"
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "404" : {
            "$ref" : "./errors.json#/components/responses/commonErrorResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.contacts.UPDATE" ]
        } ]
      }
    },
    "/api/v1/groupContacts" : {
      "get" : {
        "tags" : [ "ContactDeduplication" ],
        "summary" : "Get Duplicate Contact Details",
        "description" : "Retrieves details of duplicate contacts, with pagination support.",
        "operationId" : "listGroupedDuplicateContacts",
        "parameters" : [ {
          "name" : "include",
          "in" : "query",
          "description" : "Additional information to include in the response. Possible values: accounts",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "uniqueItems" : true,
            "type" : [ "string" ],
            "pattern" : "(accounts)"
          }
        }, {
          "name" : "fieldName",
          "in" : "query",
          "description" : "Name of the field whose values must be matched for deduplication. Possible values: firstName, lastName, email, secondaryEmail, phone, fullName, bothEmail",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "firstName", "lastName", "email", "secondaryEmail", "phone", "fullName", "bothEmail" ],
            "pattern" : "^(firstName|lastName|email|secondaryEmail|phone|fullName|bothEmail)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of contacts to fetch",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Sorts contacts by the specified attribute. Possible values: firstName, lastName, fullName, phone, email, account, createdTime, modifiedTime",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "firstName", "lastName", "fullName", "phone", "email", "createdTime", "modifiedTime" ],
            "pattern" : "-?(firstName|lastName|fullName|phone|email|createdTime|modifiedTime)"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number starting from which the contacts must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "minimum" : 0,
            "pattern" : "([0-9]+)",
            "default" : 0
          }
        }, {
          "name" : "fieldValues",
          "in" : "query",
          "description" : "Actual values in each field related to the contact",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 10000
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/listDuplicateContactResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.contacts.READ" ]
        } ]
      }
    }
  },
