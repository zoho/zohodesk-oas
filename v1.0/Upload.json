{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Upload",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/uploads" : {
      "post" : {
        "tags" : [ "Upload" ],
        "summary" : "Upload file",
        "description" : "This API uploads a file to the zoho desk service as a temporary attachment.",
        "operationId" : "uploadFile",
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/uploadFileRequest"
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/uploadFileResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.CREATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
  "components" : {
    "requestBodies" : {
      "uploadFileRequest" : {
        "description" : "Request body for uploading a file",
        "content" : {
          "multipart/form-data" : {
            "schema" : {
              "type" : "object",
              "properties" : {
                "file" : {
                  "type" : "string",
                  "format" : "binary"
                }
              },
              "required" : [ "file" ],
              "additionalProperties" : false
            }
          }
        }
      }
    },
    "responses" : {
      "uploadFileResponse" : {
        "description" : "uploadFileResponse template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "oneOf" : [ {
                "type" : [ "object", "null" ],
                "additionalProperties" : false,
                "properties" : {
                  "previewurl" : {
                    "type" : [ "string", "null" ],
                    "maxLength" : 16000000,
                    "minLength" : 0,
                    "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)",
                    "description" : "URL for previewing the uploaded file"
                  },
                  "size" : {
                    "type" : [ "string", "integer", "null" ],
                    "format" : "int64",
                    "pattern" : "([0-9]+)",
                    "description" : "Size of the uploaded file in bytes"
                  },
                  "creatorId" : {
                    "type" : [ "string", "integer", "null" ],
                    "format" : "int64",
                    "pattern" : "([0-9]+)",
                    "description" : "Unique ID of the user who uploaded the file"
                  },
                  "name" : {
                    "type" : [ "string", "null" ],
                    "maxLength" : 100,
                    "minLength" : 0,
                    "description" : "Name of the uploaded file"
                  },
                  "createdTime" : {
                    "type" : [ "string", "null" ],
                    "maxLength" : 100,
                    "minLength" : 0,
                    "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))",
                    "description" : "Timestamp when the file was uploaded, in ISO 8601 format (UTC)"
                  },
                  "id" : {
                    "type" : [ "string", "integer", "null" ],
                    "format" : "int64",
                    "pattern" : "([0-9]+)",
                    "description" : "Unique ID of the uploaded file"
                  },
                  "href" : {
                    "type" : [ "string", "null" ],
                    "maxLength" : 500,
                    "minLength" : 0,
                    "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)",
                    "description" : "API endpoint URL to access the uploaded file"
                  }
                },
                "required" : [ "createdTime", "creatorId", "href", "id", "name", "previewurl", "size" ]
              }, {
                "type" : [ "object", "null" ],
                "additionalProperties" : false,
                "properties" : {
                  "fileName" : {
                    "type" : [ "string", "null" ],
                    "maxLength" : 100,
                    "minLength" : 0,
                    "description" : "Name of the uploaded file"
                  },
                  "size" : {
                    "type" : [ "string", "integer", "null" ],
                    "format" : "int64",
                    "pattern" : "([0-9]+)",
                    "description" : "Size of the uploaded file in bytes"
                  },
                  "createdTime" : {
                    "type" : [ "string", "null" ],
                    "maxLength" : 100,
                    "minLength" : 0,
                    "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))",
                    "description" : "Timestamp when the file was uploaded, in ISO 8601 format (UTC)"
                  },
                  "id" : {
                    "type" : [ "string", "integer", "null" ],
                    "format" : "int64",
                    "pattern" : "([0-9]+)",
                    "description" : "Unique ID of the uploaded file"
                  },
                  "storeId" : {
                    "type" : [ "string", "null" ],
                    "maxLength" : 255,
                    "minLength" : 0,
                    "description" : "Storage ID where the file is stored"
                  },
                  "ownerId" : {
                    "type" : [ "string", "integer", "null" ],
                    "format" : "int64",
                    "pattern" : "([0-9]+)",
                    "description" : "Unique ID of the file owner"
                  }
                },
                "required" : [ "createdTime", "fileName", "id", "ownerId", "size", "storeId" ]
              } ]
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "size" : "4769",
                  "creatorId" : "4000000008692",
                  "name" : "zoho.jpeg",
                  "createdTime" : 1466667102000,
                  "isPublic" : false,
                  "id" : "4000000055001",
                  "href" : "https://desk.example.com/api/v1/uploads/1892000001008043/contents"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "cookie-auth" : {
        "$ref" : "./Common.json#/components/securitySchemes/cookie-auth"
      },
      "org-oauth" : {
        "$ref" : "./Common.json#/components/securitySchemes/org-oauth"
      },
      "iam-oauth2-schema" : {
        "$ref" : "./Common.json#/components/securitySchemes/iam-oauth2-schema"
      }
    }
  },
  "x-entity" : "Upload"
}