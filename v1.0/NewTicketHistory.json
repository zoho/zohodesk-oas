{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "NewTicketHistory",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/tickets/{ticketId}/History" : {
      "get" : {
        "tags" : [ "NewTicketHistory" ],
        "summary" : "Get Ticket History",
        "description" : "Retrieves details of all actions(called events) performed on a ticket and in the sub-tabs on the ticket detail page, with pagination support.",
        "operationId" : "getTicketHistory",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "agentId",
          "in" : "query",
          "description" : "ID of the agent whose actions must be included in the ticket history",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "fieldName",
          "in" : "query",
          "description" : "Name of the field to filter the ticket history. Note: The value must be the API name of the field.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "name" : "eventFilter",
          "in" : "query",
          "description" : "Filters events based on their type Possible values: CommentHistory, TimeEntryHistory, TaskHistory, CallHistory, EventHistory, AttachmentHistory, ApprovalHistory, SuperviseHistory, WorkflowHistory, MacroHistory, AssignmentRuleHistory, NotificationRuleHistory, SLAHistory, BlueprintHistory and SkillRelatedHistory",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "CommentHistory", "TimeEntryHistory", "TaskHistory", "CallHistory", "EventHistory", "AttachmentHistory", "ApprovalHistory", "SuperviseHistory", "WorkflowHistory", "MacroHistory", "AssignmentRuleHistory", "NotificationRuleHistory", "SLAHistory", "BlueprintHistory", "SkillRelatedHistory", "ZiaRelatedHistory" ],
            "pattern" : "^(CommentHistory|TimeEntryHistory|TaskHistory|CallHistory|EventHistory|AttachmentHistory|ApprovalHistory|SuperviseHistory|WorkflowHistory|MacroHistory|AssignmentRuleHistory|NotificationRuleHistory|SLAHistory|BlueprintHistory|SkillRelatedHistory|ZiaRelatedHistory)$"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of events to fetch",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 50
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number, starting from which the events must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "default" : 0
          }
        }, {
          "name" : "ticketId",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "./TicketHistory.json#/components/responses/newTicketHistoryRespns"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.tickets.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
  "x-entity" : "NewTicketHistory"
}