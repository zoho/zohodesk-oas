            "description" : "Display label of the field used in the condition"
          },
          "condition" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "Operator used for the condition. Valid operators depend on the field type: text, picklist, and lookup support is, isn't, starts with, contains, doesn't contain, ends with, is empty, is not empty; date supports is, isn't, is after, is before, is empty, is not empty; dateTime additionally supports between and not between; integer and currency support =, <>, <, <=, >, >=, is empty, is not empty; boolean supports is. Call Get Criteria Fields for Layout Rules to get the exact operators allowed for a specific field."
          },
          "fieldName" : {
            "type" : [ "string" ],
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
