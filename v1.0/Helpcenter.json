    "/api/v1/helpCenters/{helpcenterId}" : {
      "get" : {
        "tags" : [ "Helpcenter" ],
        "summary" : "Get Help Center",
        "description" : "Retrieves details of a specific help center.",
        "operationId" : "getHelpCenter",
        "x-mcp-group" : [ "Help Center Customization" ],
        "parameters" : [ {
          "name" : "helpcenterId",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/helpcenterDetailResponse"
          },
          "500" : {
            "$ref" : "./Common.json#/components/responses/internalErrorResponse"
          },
          "403" : {
