  "paths" : {
    "/api/v1/views/{cvId}/star" : {
      "post" : {
        "tags" : [ "StarredView" ],
        "summary" : "Add Star View",
        "description" : "This API stars a view, enabling quick access to the view.",
        "operationId" : "addStarredView",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department in which the view is configured",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]*|null|undefined)"
          }
        }, {
          "name" : "cvId",
          "in" : "path",
          "description" : "Unique ID of the view",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.UPDATE", "Desk.settings.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/starredViews/{cvId}/unstar" : {
      "post" : {
        "tags" : [ "StarredView" ],
        "summary" : "Remove Star View",
        "description" : "This API unstars a view, disabling quick access to the view.",
        "operationId" : "removeStarredView",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department in which the view is configured",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]*|null|undefined)"
          }
        }, {
          "name" : "cvId",
          "in" : "path",
          "description" : "Unique ID of the view",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
