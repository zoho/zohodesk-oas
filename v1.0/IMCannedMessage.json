{
  "openapi" : "3.1.0",
  "x-mcp-group" : [ "IM Canned Messages" ],
  "info" : {
    "title" : "IMCannedMessage",
    "version" : "1.0.0",
    "description" : "An IM template message is a predefined common message used to send while initiating a session. Template messages support translations, interactive buttons, headers, and footers for rich messaging across instant messaging channels."
  },
  "paths" : {
    "/api/v1/im/cannedMessages/{template_message_id}" : {
      "get" : {
        "tags" : [ "IMCannedMessage" ],
        "summary" : "Get IM Template Message",
        "description" : "Retrieves details of a specific template message.",
        "operationId" : "getCannedMessage",
        "x-mcp-group" : [ "Initiate Session" ],
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "template_message_id",
          "in" : "path",
          "description" : "Unique ID of the template message.",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the template message.",
            "maxLength" : 100,
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getCannedMessage"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "400" : {
            "$ref" : "./Common.json#/components/responses/badRequestErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.READ", "Desk.InstantMessages.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/im/cannedMessages/{template_message_id}/apply" : {
      "post" : {
        "tags" : [ "IMCannedMessage" ],
        "summary" : "Apply template message",
        "description" : "Retrieves a template message with contact information applied to the placeholders.",
        "operationId" : "applyCannedMessage",
        "x-mcp-group" : [ "Initiate Session" ],
        "x-mcp-ready" : true,
        "x-system-description" : "Call this API before Initiate Session to replace ticket and contact placeholders in a template message. Pass contactId to replace contact placeholders; contactId can be fetched from the Get Session API if not already available. Pass either ticketId or sessionId to replace ticket placeholders, but not both. If sessionId is passed, the latest ticket associated with that session is used. If a placeholder is not present in the template, it is replaced with an empty string.",
        "parameters" : [ {
          "name" : "contactId",
          "in" : "query",
          "description" : "Unique ID of the contact for which the template message must be applied or filtered.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the contact for which the template message must be applied or filtered.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "sessionId",
          "in" : "query",
          "description" : "Unique ID of the session for which template messages must be applied or filtered.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the session for which template messages must be applied or filtered.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "ticketId",
          "in" : "query",
          "description" : "Unique ID of the ticket for which template messages must be applied or filtered.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the ticket for which template messages must be applied or filtered.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "language",
          "in" : "query",
          "description" : "Language in ISO language code (e.g., en, fr, de, bn, ta) to filter or apply template messages.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Language in ISO language code (e.g., en, fr, de, bn, ta) to filter or apply template messages.",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(^([a-zA-Z0-9\\s\\.\\?\\_\\-\\,\\@\\:/+\\(\\)])*$|null|undefined)"
          }
        }, {
          "name" : "template_message_id",
          "in" : "path",
          "description" : "Unique ID of the template message.",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the template message.",
            "maxLength" : 100,
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getCannedMessage"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.CREATE", "Desk.InstantMessages.CREATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/im/cannedMessages" : {
      "get" : {
        "tags" : [ "IMCannedMessage" ],
        "summary" : "Get IM Template Messages",
        "description" : "Retrieves a list of IM template messages for the specified department, with pagination support.",
        "operationId" : "getCannedMessages",
        "x-mcp-group" : [ "Initiate Session" ],
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "modifiedAfter",
          "in" : "query",
          "description" : "Filters entities modified after the specified date. Enter a date in ISO format: yyyy-MM-ddThh:mm:ss.SSSZ.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Filters entities modified after the specified date. Enter a date in ISO format: yyyy-MM-ddThh:mm:ss.SSSZ.",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "((19|20)\\d\\d)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z"
          }
        }, {
          "name" : "tag",
          "in" : "query",
          "description" : "Search keyword to filter template messages by template name or template content.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Search keyword to filter template messages by template name or template content.",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "[a-zA-Z0-9\\_\\-\\+\\?\\!\\#\\.\\:\\,@\\;\\P{InBasicLatin}\\(\\)\\s]+"
          }
        }, {
          "name" : "contactId",
          "in" : "query",
          "description" : "Unique ID of the contact for which the template message must be applied or filtered.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the contact for which the template message must be applied or filtered.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department for which template messages must be fetched.",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the department for which template messages must be fetched.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of template messages to fetch. Defaults to 0 when omitted.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int32",
            "description" : "Number of template messages to fetch. Defaults to 0 when omitted.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which template messages must be fetched. Defaults to 0 when omitted.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int32",
            "description" : "Index number from which template messages must be fetched. Defaults to 0 when omitted.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "wabaId",
          "in" : "query",
          "description" : "WhatsApp Business Account ID for which template messages must be fetched.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "WhatsApp Business Account ID for which template messages must be fetched.",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "channelId",
          "in" : "query",
          "description" : "Unique ID of the channel for which template messages must be fetched.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the channel for which template messages must be fetched.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "type",
          "in" : "query",
          "description" : "Filter by message type. Possible values: TEMPLATE, CANNED, WELCOMEMSG, AWAY.",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Filter by message type. Possible values: TEMPLATE, CANNED, WELCOMEMSG, AWAY.",
            "enum" : [ "TEMPLATE", "CANNED", "WELCOMEMSG", "AWAY" ],
            "maxLength" : 100,
            "minLength" : 0
          }
        }, {
          "name" : "status",
          "in" : "query",
          "description" : "Filters by status of the message. Possible values: SUBMITTED, FAILED, APPROVED, REJECTED. Applicable only if type is TEMPLATE.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Filters by status of the message. Possible values: SUBMITTED, FAILED, APPROVED, REJECTED. Applicable only if type is TEMPLATE.",
            "enum" : [ "SUBMITTED", "FAILED", "APPROVED", "REJECTED" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "SUBMITTED|FAILED|APPROVED|REJECTED"
          }
        }, {
          "name" : "language",
          "in" : "query",
          "description" : "Language in ISO language code (e.g., en, fr, de, bn, ta) to filter or apply template messages.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Language in ISO language code (e.g., en, fr, de, bn, ta) to filter or apply template messages.",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(^([a-zA-Z0-9\\s\\.\\?\\_\\-\\,\\@\\:/+\\(\\)])*$|null|undefined)"
          }
        }, {
          "name" : "sessionId",
          "in" : "query",
          "description" : "Unique ID of the session for which template messages must be applied or filtered.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the session for which template messages must be applied or filtered.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "ticketId",
          "in" : "query",
          "description" : "Unique ID of the ticket for which template messages must be applied or filtered.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the ticket for which template messages must be applied or filtered.",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "isActive",
          "in" : "query",
          "description" : "Filters by active status of the template message.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "boolean",
            "description" : "Filters by active status of the template message."
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getCannedMessages"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.READ", "Desk.InstantMessages.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
