  "components" : {
    "schemas" : {
      "userDetails" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "photoUrl" : {
            "type" : [ "string", "null" ],
            "maxLength" : 400,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)",
            "description" : "URL of the follower's profile photo"
          },
          "contactId" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "name" : {
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "Display name of the follower"
          },
          "id" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the follower"
          },
          "label" : {
            "$ref" : "./Label.json#/components/schemas/labelMetaResponse"
          },
          "type" : {
            "type" : [ "string", "null" ],
            "enum" : [ "END_USER", "AGENT" ],
            "description" : "Type of user. Possible values: AGENT, END_USER."
          }
        },
        "required" : [ "contactId", "id", "label", "name", "photoUrl", "type" ],
        "description" : "Agent who moderated the user"
      },
      "userFollowersDetailsData" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/userDetails"
        },
        "description" : "List of users who follow the specified user"
      },
      "moderatedUserDetails" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "moderatedBy" : {
            "$ref" : "#/components/schemas/userDetails"
          },
          "photoUrl" : {
            "type" : [ "string", "null" ],
            "maxLength" : 400,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)",
            "description" : "URL of the moderated user's profile photo"
          },
          "contactId" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "name" : {
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "Display name of the moderated user"
          },
          "moderatedOn" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))",
            "description" : "Time at which the user was moderated (ISO 8601 format)"
          },
          "id" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the moderated user"
          },
          "type" : {
            "type" : [ "string", "null" ],
            "enum" : [ "END_USER", "AGENT" ],
            "description" : "Type of user. Possible values: AGENT, END_USER."
          },
          "status" : {
            "type" : [ "string", "null" ],
            "enum" : [ "ACTIVE", "DISABLED", "DELETED", "ANONYMIZED", "CLOSED_SUPPORT_REP", "LICENSE_DOWNGRADED_SUPPORT_REP" ],
            "description" : "Status of the user. Possible values: ACTIVE, DISABLED."
          }
        },
        "required" : [ "contactId", "id", "moderatedBy", "moderatedOn", "name", "photoUrl", "status", "type" ]
      },
      "moderatedUserDetailsData" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/moderatedUserDetails"
        },
        "description" : "List of moderated users"
      },
      "community_user_status" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "postCount" : {
            "type" : [ "string" ],
            "pattern" : "([0-9]+)",
            "description" : "Total number of topics posted by the user"
          },
          "isFollowing" : {
            "type" : [ "boolean" ]
          },
          "commentsCount" : {
            "type" : [ "string" ],
            "pattern" : "([0-9]+)"
          },
          "followersCount" : {
            "type" : [ "string" ],
            "pattern" : "([0-9]+)",
            "description" : "Number of users following this user"
          },
          "topicTypeWiseCount" : {
            "type" : [ "object" ],
            "patternProperties" : {
              "(DISCUSSION|ANNOUNCEMENT|QUESTION|IDEA|PROBLEM)" : {
                "type" : [ "string" ],
                "pattern" : "([0-9]+)"
              }
            },
            "additionalProperties" : false,
            "description" : "Breakdown of the user's topics by type"
          }
        },
        "required" : [ "postCount", "commentsCount", "followersCount", "isFollowing", "topicTypeWiseCount" ],
        "description" : "Activity statistics of the user"
      },
      "limitSchema" : {
        "type" : [ "integer" ],
        "format" : "int32",
        "maximum" : 50,
        "minimum" : 1,
        "pattern" : "([0-9]+)",
        "default" : 25
      },
      "userIdSchema" : {
        "type" : [ "string", "integer" ],
        "format" : "int64",
        "pattern" : "([0-9]+)"
      },
      "fromSchema" : {
        "type" : [ "integer" ],
        "format" : "int32",
        "minimum" : 1,
        "pattern" : "([0-9]+)",
        "default" : 1
      }
    },
