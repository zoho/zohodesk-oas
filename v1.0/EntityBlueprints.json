  "paths" : {
    "/api/v1/tickets/{ticket_id}/transitions/{transition_id}/discardDraft" : {
      "post" : {
        "tags" : [ "EntityBlueprints" ],
        "summary" : "Delete the during actions transition draft",
        "description" : "Deletes the during-actions transition draft for a specific transition on a ticket.",
        "operationId" : "deleteDuringActionTransitionDraft",
        "parameters" : [ {
          "name" : "transition_id",
          "description" : "Unique ID of the transition.",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "ticket_id",
          "description" : "Unique ID of the ticket.",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "200" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "401" : {
            "$ref" : "./Common.json#/components/responses/unauthorizedErrorResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.tickets.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/tickets/{ticket_id}/transitions/{transition_id}/saveDraft" : {
      "post" : {
        "tags" : [ "EntityBlueprints" ],
        "summary" : "Save the during actions transition draft",
        "description" : "Saves the during-actions transition draft for a specific transition on a ticket.",
        "operationId" : "saveDuringActionTransitionDraft",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "transition_id",
          "description" : "Unique ID of the transition.",
