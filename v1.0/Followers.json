          "style" : "form",
          "explode" : false,
          "schema" : {
            "$ref" : "#/components/schemas/userType"
          }
        }, {
          "name" : "moduleAPIName",
          "description" : "API name of the module in Desk. Possible values: articleTranslations, kbRootCategories, kbSections",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "articleTranslations", "kbRootCategories", "kbSections" ],
            "pattern" : "(articleTranslations|kbRootCategories|kbSections)"
          }
        }, {
          "name" : "entityId",
          "description" : "Unique ID of the entity",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
