  },
  "components" : {
    "schemas" : {
      "addSectionTranslationJson" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "name" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0
          },
          "permalink" : {
            "type" : [ "string", "null" ],
            "description" : "Permalink of the section",
            "maxLength" : 500
          },
          "description" : {
            "type" : [ "string", "null" ],
            "description" : "A short description of the section",
            "x-regex-name" : "cleartextampersand",
            "maxLength" : 300
          },
          "locale" : {
            "type" : [ "string", "null" ],
            "enum" : [ "en", "ja", "zh", "es", "de", "fr", "tr", "ru", "pt", "it", "nl", "da", "sv", "pl", "ar", "he", "af", "cs", "fr-ca", "bg", "fi", "el", "hu", "id", "nb", "ro", "th", "uk", "vi", "ur", "hi", "te", "kn", "ta", "mr", "ko", "fa", "bn", "gu", "ms", "ml", "en-gb", "sk", "hr", "sl", "zh_TW", "zh-tw", "ca", "ka", "kk", "my", "km", "pt-br" ],
            "pattern" : "([a-zA-Z]{2,4}([-_][a-zA-Z]{2})?)"
          }
        },
        "required" : [ "locale", "name" ]
      },
      "addSectionTranslationJsonArray" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/addSectionTranslationJson"
        }
      },
      "commonCategoryJson" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "visibility" : {
            "type" : [ "string", "null" ],
            "description" : "Visibility setting of the section. Possible values: AGENTS, GROUP_USERS, ALL_USERS, PRIVATE_IP, NONE",
            "enum" : [ "ALL_USERS", "AGENTS", "GROUP_USERS", "PRIVATE_IP", "NONE" ]
          },
          "translations" : {
            "description" : "List of locale-specific translations for the section",
            "$ref" : "#/components/schemas/addSectionTranslationJsonArray"
          },
          "groupIds" : {
            "description" : "List of group IDs to associate with the section",
            "type" : [ "array", "null" ],
            "items" : {
              "type" : [ "string", "integer", "null" ],
              "format" : "int64",
              "pattern" : "([0-9]+)"
            },
            "uniqueItems" : false
          },
          "name" : {
            "type" : [ "string", "null" ],
            "description" : "Name of the section",
            "maxLength" : 300,
            "pattern" : "[0-9a-zA-Z_\\-\\&\\.\\$\\@\\^\\(\\)\\{\\}\\~\\=\\-\\|\\*\\+\\?\\[\\]\\,\\:\\\"\\'\\/\\!\\P{InBasicLatin}\\s]+"
          },
          "ipAddresses" : {
            "description" : "List of IP addresses to associate with the section",
            "type" : [ "array", "null" ],
            "items" : {
              "type" : [ "object", "null" ]
            },
            "uniqueItems" : false
          },
          "status" : {
            "type" : [ "string", "null" ],
            "description" : "Activation status of the section. Possible values: SHOW_IN_HELPCENTER, HIDE_IN_HELPCENTER, DISABLED",
            "enum" : [ "SHOW_IN_HELPCENTER", "HIDE_IN_HELPCENTER", "DISABLED" ]
          }
        },
        "required" : [ "name", "translations" ]
      }
    },
    "responses" : {
      "sectionResponse" : {
        "description" : "sectionResponse template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object", "null" ],
              "additionalProperties" : false,
              "properties" : {
                "modifiedTime" : {
                  "description" : "Time when the section was last modified",
                  "type" : [ "string", "null" ],
                  "maxLength" : 100,
                  "minLength" : 0,
                  "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))"
                },
                "isFollowing" : {
                  "description" : "Indicates whether the current user is following the section. Possible values: • true = following • false = not following",
                  "type" : [ "boolean", "null" ]
                },
                "visibility" : {
                  "description" : "Visibility setting of the section. Possible values: AGENTS, GROUP_USERS, ALL_USERS, NONE",
                  "type" : [ "string", "null" ],
                  "enum" : [ "ALL_USERS", "AGENTS", "GROUP_USERS", "PRIVATE_IP", "NONE" ]
                },
                "description" : {
                  "description" : "Brief description of the section",
                  "type" : [ "string", "null" ],
                  "maxLength" : 100,
                  "minLength" : 0,
                  "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]*"
                },
                "groups" : {
                  "description" : "List of groups associated with the section",
                  "$ref" : "./KbCategory.json#/components/schemas/groupJsonArr"
                },
                "logoUrl" : {
                  "description" : "URL of the section logo",
                  "type" : [ "string", "null" ],
                  "maxLength" : 255,
                  "minLength" : 0,
                  "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
                },
                "rootCategoryId" : {
                  "description" : "Unique ID of the root category to which the section belongs",
                  "type" : [ "string", "integer", "null" ],
                  "format" : "int64",
                  "pattern" : "([0-9]+)"
                },
                "isTrashed" : {
                  "description" : "Indicates whether the section is in the Recycle Bin. Possible values: • true = in Recycle Bin • false = not in Recycle Bin",
                  "type" : [ "boolean", "null" ]
                },
                "createdBy" : {
                  "description" : "Details of the user who created the section",
                  "$ref" : "./ArticleTranslation.json#/components/schemas/modifiedBy"
                },
                "translations" : {
                  "description" : "List of locale-specific translations for the section",
                  "$ref" : "./KBRootCategory.json#/components/schemas/rootTranslationResponseJsonArr"
                },
                "name" : {
                  "description" : "Name of the section",
                  "type" : [ "string", "null" ],
                  "maxLength" : 100,
                  "minLength" : 0
                },
                "createdTime" : {
                  "description" : "Time when the section was created",
                  "type" : [ "string", "null" ],
                  "maxLength" : 100,
                  "minLength" : 0,
                  "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))"
                },
                "modifiedBy" : {
                  "description" : "Details of the user who last modified the section",
                  "$ref" : "./ArticleTranslation.json#/components/schemas/modifiedBy"
                },
                "parentCategoryId" : {
                  "description" : "Unique ID of the parent category",
                  "type" : [ "string", "integer", "null" ],
                  "format" : "int64",
                  "pattern" : "([0-9]+)"
                },
                "ipAddresses" : {
                  "description" : "List of IP addresses associated with the section",
                  "type" : [ "array", "null" ],
                  "items" : {
                    "type" : [ "string", "null" ],
                    "maxLength" : 100,
                    "minLength" : 0,
                    "pattern" : "^((?:(?:(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\*)\\.){3}(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\*)(\\/(?:[012]?[0-9]|3[012]))?)|\\*)$"
                  },
                  "uniqueItems" : false
                },
                "id" : {
                  "description" : "Unique ID of the section",
                  "type" : [ "string", "integer" ],
                  "format" : "int64",
                  "pattern" : "([0-9]+)"
