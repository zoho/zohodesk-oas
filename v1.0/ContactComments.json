              "description" : "URL of the mentioned entity's profile photo"
            },
            "offset" : {
              "type" : [ "string", "integer", "null" ],
              "format" : "int32",
              "pattern" : "([0-9]+)",
              "description" : "Start position of the mention in the comment content"
