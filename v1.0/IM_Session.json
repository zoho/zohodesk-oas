          "description" : "Filter conversations assigned to an agent",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Filter conversations assigned to an agent",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "contactId",
          "in" : "query",
          "description" : "Filter conversations of a contact",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
