          "in" : "path",
          "required" : true,
          "description" : "Unique ID of the help center",
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
