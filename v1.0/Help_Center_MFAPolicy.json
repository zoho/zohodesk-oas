  "components" : {
    "schemas" : {
      "hcMFAJson" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "status" : {
            "description" : "Status of the MFA Policy. Possible values: ENABLED — The MFA policy is ENABLED for the help center. DISABLED — The MFA policy is DISABLED for the help center.",
            "type" : [ "string", "null" ],
            "maxLength" : 30,
            "minLength" : 0,
            "pattern" : "ENABLED|DISABLED"
          },
          "mfaMethods" : {
            "description" : "Sets the MFA method for authentication. Possible values: TOTP.",
            "type" : [ "array", "null" ],
            "items" : {
              "type" : [ "string", "null" ],
              "maxLength" : 4,
              "minLength" : 0,
              "pattern" : "TOTP"
            },
            "maxItems" : 20,
            "minItems" : 1,
            "uniqueItems" : false
          },
          "sessionValidity" : {
            "description" : "Specifies the MFA session validity duration. The maximum session validity is 180 days.",
            "type" : [ "string" ],
            "maxLength" : 3,
            "minLength" : 1,
            "pattern" : "^(0|[1-9][0-9]?|1[0-7][0-9]|180)$"
          }
        }
      },
      "hcMFAPolicyJSON" : {
        "additionalProperties" : false,
        "allOf" : [ {
          "$ref" : "#/components/schemas/hcMFAJson"
        } ]
      }
    },
    "responses" : {
      "hcMFAPolicyResponse" : {
        "description" : "mfaPolicyResponse template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "additionalProperties" : false,
              "allOf" : [ {
                "$ref" : "#/components/schemas/hcMFAPolicyJSON"
              } ]
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "mfaMethods" : [ "TOTP" ],
                  "sessionValidity" : "180",
                  "status" : "ENABLED"
                }
              }
            }
          }
        }
      }
    },
    "requestBodies" : {
      "hcMFARequestJson" : {
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object" ],
              "additionalProperties" : false,
              "properties" : {
                "status" : {
                  "description" : "Status of the MFA Policy. Possible values: ENABLED — The MFA policy is ENABLED for the help center. DISABLED — The MFA policy is DISABLED for the help center.",
                  "type" : [ "string" ],
                  "maxLength" : 30,
                  "pattern" : "ENABLED|DISABLED",
                  "enum" : [ "ENABLED", "DISABLED" ]
                },
                "mfaMethods" : {
                  "description" : "Sets the MFA method for authentication. Possible values: TOTP.",
                  "type" : [ "array" ],
                  "items" : {
                    "type" : [ "string" ],
                    "maxLength" : 4,
                    "minLength" : 3,
                    "pattern" : "TOTP",
                    "enum" : [ "TOTP" ]
                  },
                  "maxItems" : 20,
                  "minItems" : 1,
                  "uniqueItems" : false
                },
                "sessionValidity" : {
                  "description" : "Specifies the MFA session validity duration. The maximum session validity is 180 days.",
                  "type" : [ "string" ],
                  "maxLength" : 3,
                  "minLength" : 1,
                  "pattern" : "^(0|[1-9][0-9]?|1[0-7][0-9]|180)$"
                }
              }
            }
          }
        }
      }
    },
