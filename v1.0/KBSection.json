          "200" : {
            "$ref" : "#/components/responses/sectionResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.articles.READ" ]
        } ]
      },
      "patch" : {
        "tags" : [ "KBSection" ],
        "summary" : "Update a KB section",
        "description" : "This API updates a section in your helpdesk",
        "operationId" : "updateKBSection",
        "x-mcp-group" : [ "KB Admin", "Manage KB Category" ],
        "parameters" : [ {
          "name" : "sectionId",
          "in" : "path",
          "description" : "Unique ID of the section",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/commonCategoryJson"
        },
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/sectionResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.articles.UPDATE" ]
        } ]
      }
    },
