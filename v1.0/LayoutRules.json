            "maxLength" : 250,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "Display label of the field"
          },
          "fieldName" : {
            "type" : [ "string" ],
            "maxLength" : 250,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "Name of the field"
          }
        },
        "required" : [ "displayLabel", "fieldName" ]
      },
      "LayoutRuleActionFieldArray" : {
        "type" : [ "array" ],
        "items" : {
          "$ref" : "#/components/schemas/LayoutRuleActionFieldJSON"
        },
        "maxItems" : 1000
      },
      "actions" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "description" : "Actions executed when the condition block matches",
        "properties" : {
          "showSections" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "maxLength" : 100,
              "minLength" : 0
            },
            "maxItems" : 1000,
            "description" : "Section name(s) to show"
          },
          "showFields" : {
