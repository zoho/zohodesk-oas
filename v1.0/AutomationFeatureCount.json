{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "AutomationFeatureCount",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/automationFeatureCount" : {
      "get" : {
        "tags" : [ "AutomationFeatureCount" ],
        "summary" : "Get Automation Feature Count",
        "description" : "Retrieves automation feature limits for the specified feature. For businesshours and holidaylist, no additional parameters are mandatory. For workflows, both module and departmentId are mandatory. Valid module values for workflows are tickets, contacts, contracts, accounts, tasks, products, and timeEntry. For Skills and SkillType, departmentId is mandatory.",
        "operationId" : "getUsedCountForAutomationFeature",
        "parameters" : [ {
          "name" : "feature",
          "in" : "query",
          "description" : "Automation feature for which the count must be retrieved. Possible values: businesshours, holidaylist, Skills, SkillType, workflows, blueprints, automationAlerts, fieldUpdates, automationTasks, customFunctions",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "businesshours", "holidaylist", "Skills", "SkillType", "workflows", "blueprints", "SupportPlans", "automationAlerts", "fieldUpdates", "automationTasks", "customFunctions" ]
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department for which the feature count must be retrieved. Required for all features except businesshours and holidaylist.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "module",
          "in" : "query",
          "description" : "Module for which the feature count must be retrieved. Required for workflows, blueprints (must be tickets), automationAlerts, and customFunctions. Ignored for Skills, SkillType, SupportPlans, automationTasks, fieldUpdates, businesshours, and holidaylist. Possible values: tickets, contacts, contracts, accounts, tasks, products, timeEntry, events, calls, customModule",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "tickets", "contacts", "contracts", "accounts", "tasks", "products", "timeEntry", "events", "calls", "customModule" ],
            "pattern" : "tickets|contacts|contracts|accounts|tasks|products|timeEntry|events|calls|(cm_[a-zA-Z0-9\\_]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "500" : {
            "$ref" : "./Common.json#/components/responses/internalErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/automationFeatureCountJSONResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.automations.READ", "Desk.basic.READ", "Desk.settings.READ" ]
        } ],
        "x-audience" : [ "external-public" ],
        "x-mcp-ready" : true
      }
    }
  },
  "components" : {
    "schemas" : {
      "usedCountInfoResponse" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "maxProperties" : 2,
        "minProperties" : 2,
        "properties" : {
          "usedTotalCount" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          },
          "usedActiveCount" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          }
        },
        "required" : [ "usedActiveCount", "usedTotalCount" ]
      },
      "automationFeatureCountResponse" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "featureName" : {
            "type" : [ "string", "null" ],
            "enum" : [ "workflows", "businesshours", "holidaylist", "blueprints", "Skills", "SkillType", "SupportPlans", "automationAlerts", "fieldUpdates", "automationTasks", "customFunctions" ]
          },
          "maxTotalCount" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          },
          "maxActiveCount" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          },
          "usedCountInfo" : {
            "$ref" : "#/components/schemas/usedCountInfoResponse"
          }
        },
        "required" : [ "featureName", "maxActiveCount", "maxTotalCount", "usedCountInfo" ]
      }
    },
    "responses" : {
      "automationFeatureCountJSONResponse" : {
        "description" : "automationFeatureCountJSONResponse template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/automationFeatureCountResponse"
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "featureName" : "workflows",
                  "maxTotalCount" : "40",
                  "maxActiveCount" : "20",
                  "usedCountInfo" : {
                    "usedTotalCount" : "3",
                    "usedActiveCount" : "2"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "cookie-auth" : {
        "$ref" : "./Common.json#/components/securitySchemes/cookie-auth"
      },
      "org-oauth" : {
        "$ref" : "./Common.json#/components/securitySchemes/org-oauth"
      },
      "jwt-oauth" : {
        "$ref" : "./Common.json#/components/securitySchemes/jwt-oauth"
      },
      "iam-oauth2-schema" : {
        "$ref" : "./Common.json#/components/securitySchemes/iam-oauth2-schema"
      }
    }
  },
  "x-entity" : "AutomationFeatureCount"
}