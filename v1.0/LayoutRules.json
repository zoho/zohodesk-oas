          "explode" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "enum" : [ "creator", "modifier" ],
              "description" : "Accepted values: creator, modifier"
            },
            "maxItems" : 2
          }
        }, {
          "name" : "layoutRuleId",
          "in" : "path",
          "description" : "Unique ID of the layout rule",
          "required" : true,
