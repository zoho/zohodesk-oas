{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "License",
    "version" : "1.0.0",
    "description" : "These APIs work with licensing in Zoho Desk."
  },
  "tags" : [ {
    "name" : "License",
    "description" : "These APIs work with licensing in Zoho Desk."
  } ],
  "paths" : {
    "/api/v1/licenses/features" : {
      "get" : {
        "tags" : [ "License" ],
        "summary" : "Get License Feature Details",
        "description" : "Retrieves all available license features in Desk along with their applicability and usage limits for the current portal.",
        "operationId" : "featureInfo",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "featureCodes",
          "in" : "query",
          "required" : false,
          "description" : "Returns feature details for the specified feature codes <p><b>Note:</b> Multiple codes can be provided by separating them with commas</p>",
          "schema" : {
            "type" : [ "array" ],
            "maxItems" : 50,
            "items" : {
              "type" : [ "string" ]
            }
          },
          "style" : "form",
          "explode" : false
        }, {
          "name" : "isAllowed",
          "in" : "query",
          "required" : false,
          "description" : "Filters features based on whether they are allowed for the current portal  <p><b>Possible values:</b>  - true = returns allowed features   - false = returns disallowed features</p>",
          "schema" : {
            "type" : [ "boolean" ]
          },
          "style" : "form",
          "explode" : true
        }, {
          "name" : "includeDetailedLimits",
          "in" : "query",
          "required" : false,
          "description" : "Includes detailed per-unit feature limits instead of only max values <p><b>Possible values:</b>  - true = includes detailed per-unit limits   - false = includes only max values</p>",
          "schema" : {
            "type" : [ "boolean" ]
          },
          "style" : "form",
          "explode" : true
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/featureInfoResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          }
        },
        "x-audience" : [ "external-public" ],
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.READ", "Desk.settings.READ" ]
        } ]
      }
    },
    "/api/v1/licenses/plan" : {
      "get" : {
        "tags" : [ "License" ],
        "summary" : "Get License Plan Details",
        "description" : "Retrieves the current portal's license plan information.",
        "operationId" : "planinfo",
        "x-mcp-ready" : true,
        "x-audience" : [ "external-public" ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/planinfoResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.READ", "Desk.settings.READ" ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "LicenseUnitValue" : {
        "type" : [ "object" ],
        "description" : "Detailed license unit value information",
        "properties" : {
          "unitCode" : {
            "type" : [ "string" ],
            "description" : "Type of unit for which the limit applies",
            "example" : "ORG"
          },
          "maxValue" : {
            "type" : [ "integer" ],
            "description" : "Maximum quota allowed for the feature  <p><b>Note:</b> A value of -1 indicates unlimited usage</p>",
            "example" : 33
          },
          "freeValue" : {
            "type" : [ "integer" ],
            "description" : "Free quota available for the feature irrespective of plan or add-ons   <p><b>Note:</b> Returned when includeDetailedLimits is true</p>",
            "example" : 5
          },
          "addOnValue" : {
            "type" : [ "integer" ],
            "description" : "Additional quota provided through purchased add-ons  <p><b>Note:</b> Returned when includeDetailedLimits is true</p>",
            "example" : 3
          }
        },
        "required" : [ "unitCode", "maxValue" ],
        "additionalProperties" : false
      },
      "SimpleLicenseUnit" : {
        "type" : [ "object" ],
        "description" : "Simple license unit with only max value",
        "properties" : {
          "unitCode" : {
            "type" : [ "string" ],
            "description" : "Type of unit for which the limit applies",
            "example" : "ORG"
          },
          "maxValue" : {
            "type" : [ "integer" ],
            "description" : "Maximum quota allowed for the feature  <p><b>Note:</b> A value of -1 indicates unlimited usage</p>",
            "example" : 33
          }
        },
        "required" : [ "unitCode", "maxValue" ],
        "additionalProperties" : false
      },
      "FeatureAllowed" : {
        "type" : [ "object" ],
        "description" : "Details of an allowed feature with flexible limit information.",
        "properties" : {
          "featureCode" : {
            "type" : [ "string" ],
            "description" : "Unique feature code defined in the license framework",
            "example" : "AGNT01"
          },
          "featureName" : {
            "type" : [ "string" ],
            "description" : "Display name of the feature",
            "example" : "Agent"
          },
          "isAllowed" : {
            "type" : [ "boolean" ],
            "description" : "Indicates whether the feature is enabled for the current portal  <p><b>Possible values:</b>  - true = feature is enabled   - false = feature is disabled</p>",
            "example" : true
          },
          "limits" : {
            "type" : [ "array" ],
            "description" : "License limit details for the feature  <p><b>Note:</b> Returned as an empty list when data.isAllowed is false</p>",
            "items" : {
              "anyOf" : [ {
                "$ref" : "#/components/schemas/SimpleLicenseUnit"
              }, {
                "$ref" : "#/components/schemas/LicenseUnitValue"
              } ]
            },
            "example" : [ {
              "unitCode" : "ORG",
              "maxValue" : 33,
              "freeValue" : 5,
              "addOnValue" : 3
            } ]
          }
        },
        "required" : [ "featureCode", "featureName", "isAllowed" ],
        "additionalProperties" : false
      },
      "LicenseFeatureListResponse" : {
        "type" : [ "object" ],
        "properties" : {
          "data" : {
            "type" : [ "array" ],
            "items" : {
              "$ref" : "#/components/schemas/FeatureAllowed"
            },
            "description" : "List of license features"
          }
        },
        "additionalProperties" : false
      },
      "PlanInfoResponse" : {
        "type" : [ "object" ],
        "description" : "Detailed information about the current license plan.",
        "properties" : {
          "planName" : {
            "type" : [ "string" ],
            "description" : "Name of the current plan",
            "example" : "Enterprise"
          },
          "planCode" : {
            "type" : [ "string" ],
            "description" : "Code of the current plan",
            "example" : "E2019"
          },
          "planStatus" : {
            "type" : [ "string" ],
            "description" : "Status of the plan",
            "example" : "PAID"
          },
          "expiryDate" : {
            "type" : [ "integer" ],
            "format" : "int64",
            "description" : "Expiry date of the current plan in epoch milliseconds",
            "example" : 1749203963937
          },
          "billingCycle" : {
            "type" : [ "string" ],
            "description" : "Billing cycle of the plan",
            "example" : "Yearly"
          },
          "storePlanId" : {
            "type" : [ "integer" ],
            "description" : "Store plan ID of the current plan",
            "example" : 12345
          },
          "storeProfileId" : {
            "type" : [ "string" ],
            "description" : "Store profile ID associated with the plan",
            "example" : "prof_abc123"
          },
          "previousPlanCode" : {
            "type" : [ "string", "null" ],
            "description" : "Code of the previous plan",
            "example" : "PRO01"
          }
        },
        "additionalProperties" : false
      }
    },
    "responses" : {
      "featureInfoResponse" : {
        "description" : "Successfully retrieved feature information.",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/LicenseFeatureListResponse"
            },
            "examples" : {
              "simple" : {
                "summary" : "Simple mode (includeDetailedLimits=false)",
                "value" : {
                  "data" : [ {
                    "featureCode" : "AGNT01",
                    "featureName" : "Agent",
                    "isAllowed" : true,
                    "limits" : [ {
                      "unitCode" : "ORG",
                      "maxValue" : 33
                    } ]
                  } ]
                }
              },
              "detailed" : {
                "summary" : "Detailed mode (includeDetailedLimits=true)",
                "value" : {
                  "data" : [ {
                    "featureCode" : "AGNT01",
                    "featureName" : "Agent",
                    "isAllowed" : true,
                    "limits" : [ {
                      "unitCode" : "ORG",
                      "maxValue" : 33,
                      "freeValue" : 5,
                      "addOnValue" : 3
                    } ]
                  } ]
                }
              }
            }
          }
        }
      },
      "planinfoResponse" : {
        "description" : "Successfully retrieved plan information.",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/PlanInfoResponse"
            },
            "examples" : {
              "success" : {
                "value" : {
                  "planName" : "Enterprise",
                  "planCode" : "E2019",
                  "planStatus" : "PAID",
                  "expiryDate" : 1749203963937,
                  "billingCycle" : "Yearly",
                  "storePlanId" : 10218,
                  "storeProfileId" : "REDS01012019",
                  "previousPlanCode" : "E2019"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "cookie-auth" : {
        "$ref" : "./Common.json#/components/securitySchemes/cookie-auth"
      },
      "org-oauth" : {
        "$ref" : "./Common.json#/components/securitySchemes/org-oauth"
      },
      "iam-oauth2-schema" : {
        "$ref" : "./Common.json#/components/securitySchemes/iam-oauth2-schema"
      }
    }
  },
  "x-entity" : "License"
}