{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Sandbox Changeset",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/sandbox/{sandboxId}/changesets/count" : {
      "get" : {
        "tags" : [ "SandboxChangeset" ],
        "summary" : "Get Sandbox Changeset Count",
        "description" : "Retrieves the count of all changesets in a sandbox, grouped by action type.",
        "operationId" : "getChangesetCount",
        "x-mcp-group" : [ "Sandbox Changeset" ],
        "parameters" : [ {
          "$ref" : "./Sandbox.json#/components/parameters/sandboxId"
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/getCountResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.sandbox.READ" ]
        } ]
      }
    },
    "/api/v1/sandbox/{sandboxId}/changesets" : {
      "get" : {
        "tags" : [ "SandboxChangeset" ],
        "summary" : "Get Sandbox Changesets",
        "description" : "Retrieves all changesets in a sandbox, with pagination support.",
        "operationId" : "getAllChangeSets",
        "x-mcp-group" : [ "Sandbox Changeset" ],
        "parameters" : [ {
          "name" : "entityType",
          "in" : "query",
          "description" : "Filters changesets based on a specific entity type. Possible values: Fields, Layouts, Layout Rules, Validation Rules, Ticket Templates, Email Templates Folder, Email Templates, Modules, Time Tracking, Field Dependencies, Direct Assignment Rule, Round Robin Rule, Notification Rules, Feed Preferences, Skill Type, Skills, Skill Configuration, Alerts, Tasks, Field Updates, Custom Function, Schedules, Macro, Supervise, Custom Action, Blueprint, Workflow, SLA, ActionMapping, Automation Studio. Note: The default value includes all entities",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "$ref" : "./Sandbox.json#/components/schemas/sandboxEntityType"
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department to filter changesets by. Note: The default value includes all departments",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "module",
          "in" : "query",
          "description" : "Filters changesets based on a specific module apiName. Possible values: tickets, contacts, accounts, tasks, calls, events, timeEntry, contracts, products and custom module apiName. Note: The default response includes all modules",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s\\^\\{\\}\\~\\[\\]\\*\\+~\\|\\\"]+",
            "x-regex-name" : "cleartextpattern"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of changesets to fetch. The maximum value allowed is 50",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 50,
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "default" : 50
          }
        }, {
          "name" : "action",
          "in" : "query",
          "description" : "Filters changesets based on their action type. Possible values: ADD, UPDATE, DELETE. Note: The default value includes all actions",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "ADD", "UPDATE", "DELETE" ]
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which changesets must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "default" : 1
          }
        }, {
          "$ref" : "./Sandbox.json#/components/parameters/sandboxId"
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/allSandboxChangesetResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.sandbox.READ" ]
        } ]
      }
    }
  },
  "components" : {
