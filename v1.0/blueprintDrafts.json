{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "blueprintDrafts",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/blueprintDrafts" : {
      "post" : {
        "tags" : [ "blueprintDrafts" ],
        "summary" : "Create Draft Blueprint",
        "description" : "Creates a new blueprint in draft state for review before publishing. Use this when building or iterating on a blueprint configuration without making it active. Requires the full blueprint configuration including states, transitions, connections, and chart data.",
        "operationId" : "createDraft",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/createBlueprintDraft",
          "required" : true
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/createBlueprintDraftResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.automations.CREATE", "Desk.settings.CREATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/blueprintDrafts/{draftblueprint_id}" : {
      "patch" : {
        "tags" : [ "blueprintDrafts" ],
        "summary" : "Update Draft Blueprint",
        "description" : "Updates an existing draft blueprint with the specified configuration changes. Use this to revise draft states, transitions, criteria, or chart layout before publishing.",
        "operationId" : "updateDraft",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "draftblueprint_id",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          },
          "description" : "Unique ID of the draft blueprint. Required."
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/updateBlueprintDraft",
          "required" : true
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/createBlueprintDraftResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.automations.UPDATE", "Desk.settings.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/blueprintDrafts/{draftblueprint_id}/publish" : {
      "post" : {
        "tags" : [ "blueprintDrafts" ],
        "summary" : "Publish Draft Blueprint",
        "description" : "Publishes a draft blueprint. Use this when the draft configuration is finalized.",
        "operationId" : "publishDraftBlueprint",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "draftblueprint_id",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          },
          "description" : "Unique ID of the draft blueprint. Required."
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/publishBlueprintDraft",
          "required" : true
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "./blueprints.json#/components/responses/createBlueprintResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.automations.UPDATE", "Desk.settings.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "createBlueprintDraft_schema" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "criteria" : {
            "description" : "Rules defining when the blueprint is automatically applied to matching tickets. Type: object with fieldConditions and pattern. Optional; omit to apply manually only.",
            "$ref" : "./blueprintCriteria.json#/components/schemas/criteriaObject"
          },
          "departmentId" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique identifier of the department that owns this blueprint. Type: integer or string (int64). Required. Must match an existing department. Example: 4000000007235."
          },
          "module" : {
            "type" : [ "string" ],
            "enum" : [ "tickets" ],
            "pattern" : "tickets",
            "description" : "Desk module the blueprint applies to. Type: string enum. Required. Currently only tickets is supported. Example: \"tickets\"."
          },
          "description" : {
            "type" : [ "string" ],
            "maxLength" : 1000,
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+|^$",
            "description" : "Optional human-readable summary of the blueprint purpose. Type: string, max 1000 characters. Optional. Example: \"Automates Private Threading Handling\"."
          },
          "dynamicTransOwnerType" : {
            "type" : [ "string" ],
            "enum" : [ "ACTIVE", "INACTIVE" ],
            "pattern" : "ACTIVE|INACTIVE",
            "description" : "Controls dynamic transition owner assignment at runtime. Type: string enum. Optional. Possible values: ACTIVE = enabled, INACTIVE = disabled. Default behavior if omitted depends on org settings. Example: \"INACTIVE\"."
          },
          "type" : {
            "type" : [ "string" ],
            "enum" : [ "NON_CONTINUOUS", "CONTINUOUS" ],
            "pattern" : "NON_CONTINUOUS|CONTINUOUS",
            "description" : "Blueprint flow type controlling transition continuity. Type: string enum. Required. Possible values: NON_CONTINUOUS, CONTINUOUS. Example: \"NON_CONTINUOUS\"."
          },
          "transitions" : {
            "description" : "Transition definitions including before, during, and after actions. Type: array of transition objects. Required.",
            "$ref" : "./blueprintTransitions.json#/components/schemas/transitionsArray"
          },
          "layoutId" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique identifier of the ticket layout mapped to this blueprint. Type: integer or string (int64). Required. Determines available fields and criteria. Example: 4000000007723."
          },
          "states" : {
            "description" : "State definitions including SLA times and escalations. Type: array of state objects. Required. Must include START, INTERMEDIATE, and END states.",
            "$ref" : "./blueprintStates.json#/components/schemas/statesArray"
          },
          "chartData" : {
            "description" : "Visual layout data for the blueprint designer canvas. Type: object with canvasPosition, connectionDetails, and stateDetails. Required. MCP note: logical flow is defined in connections/transitions/states, but the UI draws lines only from chartData.connectionDetails. Each connection entry must include fromUuid, toUuid, fromState, toState, and transName. Use unique canvas anchor UUIDs per endpoint; when a state both receives and sends a connection, do not reuse the same anchor (for example, use toUuid \"On Hold1\" for incoming and fromUuid \"On Hold2\" for outgoing).",
            "$ref" : "./blueprintChartData.json#/components/schemas/draftChartDataObject"
          },
          "strictModeConfig" : {
            "description" : "Strict mode restrictions limiting field edits outside transitions. Type: object or null. Optional; pass null for non-strict mode.",
            "$ref" : "./blueprintStrictModeConfig.json#/components/schemas/strictModeConfigObject"
          },
          "name" : {
            "type" : [ "string" ],
            "maxLength" : 60,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "Display name of the blueprint draft. Type: string, max 60 characters, pattern cleartext. Required. Shown in blueprint settings after publish. Example: \"Private Threading Handling\"."
          },
          "connections" : {
            "description" : "Mappings linking source states to destination states via transitions. Type: array of connection objects. Required.",
            "$ref" : "./blueprintConnections.json#/components/schemas/connectionsArray"
          },
          "fieldId" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique identifier of the ticket field mapped to this blueprint (typically Status). Type: integer or string (int64). Required. Example: 4000000000377."
          }
        },
        "required" : [ "chartData", "connections", "departmentId", "fieldId", "layoutId", "module", "name", "states", "transitions", "type" ]
      },
      "updateBlueprintDraft_schema" : {
        "$ref" : "#/components/schemas/createBlueprintDraft_schema"
      },
