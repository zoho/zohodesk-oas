{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "AccountDeduplication",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/accountsDeduplication/defaultFieldName" : {
      "get" : {
        "tags" : [ "AccountDeduplication" ],
        "summary" : "Get Default Field Name",
        "description" : "Retrieves the name of the field set as the default field for account deduplication.",
        "operationId" : "getDefaultFieldNameForAccountDeduplication",
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/getDefaultFieldResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.accounts.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.contacts.READ" ]
        } ]
      },
      "post" : {
        "tags" : [ "AccountDeduplication" ],
        "summary" : "Set Default Field",
        "description" : "Sets the specified field as the default field for account deduplication.",
        "operationId" : "setDefaultFieldNameForAccountDeduplication",
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/setDefaultField"
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "404" : {
            "$ref" : "./errors.json#/components/responses/commonErrorResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.accounts.UPDATE" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.contacts.UPDATE" ]
        } ]
      }
    },
    "/api/v1/groupAccountDuplicateValues" : {
      "get" : {
        "tags" : [ "AccountDeduplication" ],
        "summary" : "Get Duplicate Accounts",
        "description" : "Retrieves duplicate account groups based on the specified field, with pagination support.\n\nNote: If the API returns a 202 status code, it means there are 100,000 or more accounts in the help desk portal. Matching records and finding duplicates is time-consuming in such scenarios, so the deduplication request is accepted and processed in the background. An automated report is sent to the user who initiated the deduplication once the process is complete.",
        "operationId" : "listGroupedDuplicateAccounts",
        "parameters" : [ {
          "name" : "fieldName",
          "in" : "query",
          "description" : "Name of the field whose values must be matched for deduplication. Values allowed are: email, phone, and accountName",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "enum" : [ "email", "phone", "accountName" ],
            "pattern" : "^(email|phone|accountName)"
          }
        }, {
          "name" : "swFieldValue",
          "in" : "query",
          "description" : "Key that specifies the letter with which the field values must start",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of accounts to fetch",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number starting from which the accounts must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "minimum" : 0,
            "pattern" : "([0-9]+)",
            "default" : 0
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Key that sorts the accounts by a specific attribute: count or fieldValue. The default sorting order is ascending. A - prefix denotes descending order of sorting.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "enum" : [ "count", "fieldValue" ],
            "pattern" : "-?(count|fieldValue)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/listDuplicateAccountsCountsResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.accounts.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.contacts.READ" ]
        } ]
      }
    },
    "/api/v1/groupAccounts" : {
      "get" : {
        "tags" : [ "AccountDeduplication" ],
        "summary" : "Get Duplicate Account Details",
        "description" : "Retrieves full details of duplicate accounts grouped by the specified field value, with pagination support.",
        "operationId" : "listDuplicateAccounts",
        "parameters" : [ {
          "name" : "fieldName",
          "in" : "query",
          "description" : "Name of the field whose values must be matched for deduplication. Values allowed are: email, phone, and accountName",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "enum" : [ "email", "phone", "accountName" ],
            "pattern" : "^(email|phone|accountName)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of accounts to fetch",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Key that sorts the accounts by a specific attribute: accountName or createdTime or modifiedTime. The default sorting order is ascending. A - prefix denotes descending order of sorting.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "enum" : [ "accountName", "createdTime", "modifiedTime" ],
            "pattern" : "-?(website|email|phone|accountName|createdTime|modifiedTime)"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number starting from which the accounts must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "minimum" : 0,
            "pattern" : "([0-9]+)",
            "default" : 0
          }
        }, {
          "name" : "fieldValues",
          "in" : "query",
          "description" : "Actual values in each field related to the account",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 10000
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/listDuplicateAccountResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.accounts.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.contacts.READ" ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "accountsArray" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "./Account.json#/components/schemas/accountListViewObject"
        }
      },
      "duplicateResponse" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "accounts" : {
            "$ref" : "#/components/schemas/accountsArray"
          },
          "fieldValue" : {
            "description" : "Field value shared among the duplicate accounts",
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "accounts", "fieldValue" ]
      },
      "duplicateResponseData" : {
        "type" : [ "array", "null" ],
