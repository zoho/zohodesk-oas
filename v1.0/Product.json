        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "include",
          "in" : "query",
          "description" : "Secondary information related to the product. Value supported is owner.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "enum" : [ "owner" ]
            },
            "uniqueItems" : true
          }
        }, {
          "name" : "viewId",
          "in" : "query",
          "description" : "ID of the view to apply while fetching the products",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "ID of the department from which the products count must be computed. If you want to count of the products configured in all accessible departments, pass the value 0.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "No. of products to fetch",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number, starting from which the products must be fetched. The index is zero-based (the first product is at index 0).",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Sort by a specific attribute : productName, productCode, unitPrice, createdTime or modifiedTime. The default sorting order is ascending. A '-' prefix denotes descending order of sorting.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "productName", "productCode", "unitPrice", "createdTime", "modifiedTime", "-productName", "-productCode", "-unitPrice", "-createdTime", "-modifiedTime" ],
            "pattern" : "-?(productName|productCode|unitPrice|createdTime|modifiedTime)",
            "maxLength" : 100
          }
        }, {
          "name" : "ownerId",
          "in" : "query",
          "description" : "Displays the number of products of only a particular owner",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        }, {
          "name" : "fields",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ]
            }
          },
          "description" : "Key that returns the values of mentioned fields (both pre-defined and custom) in your portal. All field types except multi-text are supported. Standard, non-editable fields are supported too. These fields include: layoutId. Maximum of 30 fields is supported as comma separated values.",
          "style" : "form",
          "explode" : false
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/productListViewArray"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.READ", "Desk.products.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
