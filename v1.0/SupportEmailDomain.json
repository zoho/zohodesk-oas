        "summary" : "Get Support email address domain",
        "description" : "This API fetches the domain of the support email address.",
        "operationId" : "getSupportEmailAddressDomain",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
