  "components" : {
    "schemas" : {
      "getSiteMapResponse" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "generatedTime" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))"
          },
          "isGenerated" : {
            "type" : [ "boolean", "null" ]
          },
          "downloadUrl" : {
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
          },
          "url" : {
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
          }
        },
        "required" : [ "downloadUrl", "generatedTime", "isGenerated", "url" ]
      },
      "helpcenterLocaleObj" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "name" : {
            "description" : "Display name of the help center as shown to end users in that specific locale.",
            "type" : [ "string" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "^[0-9a-zA-Z\\!\\$\\|\\%&amp;\\#\\-\\*\\+\\,\\^\\_\\`\\~\\s\\.\\P{InBasicLatin}]+$"
          },
          "locale" : {
            "description" : "Locale code of the Help Center. Possible values: en, fr, de, es, ja, zh, pt, nl",
            "type" : [ "string" ],
            "enum" : [ "en", "ja", "zh", "es", "de", "fr", "tr", "ru", "pt", "it", "nl", "da", "sv", "pl", "ar", "he", "af", "cs", "fr-ca", "bg", "fi", "el", "hu", "id", "nb", "ro", "th", "uk", "vi", "ur", "hi", "te", "kn", "ta", "mr", "ko", "fa", "bn", "gu", "ms", "ml", "en-gb", "sk", "hr", "sl", "zh_TW", "zh-tw", "ca", "ka", "kk", "my", "km", "pt-br" ],
            "pattern" : "([a-zA-Z]{2,4}([-_][a-zA-Z]{2})?)"
          },
          "type" : {
            "description" : "Type of the locale. Possible values: DEFAULT, OTHER",
            "type" : [ "string" ],
            "enum" : [ "DEFAULT", "OTHER" ]
          },
          "status" : {
            "description" : "Status of the locale. Visibility state of the locale. Possible values: ACCESIBLE_IN_HELPCENTER: Visible in Help Center, DISABLED_IN_HELPCENTER: Restricted in Help Center, DISABLED: Restricted in both Help Center and Desk",
            "type" : [ "string" ],
            "enum" : [ "ACCESIBLE_IN_HELPCENTER", "DISABLED_IN_HELPCENTER", "DISABLED" ]
          }
        },
        "required" : [ "locale", "name", "status", "type" ]
      },
      "helpcenterLocaleList" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/helpcenterLocaleObj"
        }
      },
      "helpcenterDefaultResponse" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "isDefault" : {
            "type" : [ "boolean", "null" ],
            "description" : "Indicates whether the help center is the default one. Possible values: true = default help center, false = not the default help center"
          },
          "locales" : {
            "description" : "List of locales supported by the help center",
            "type" : [ "array", "null" ],
            "items" : {
              "type" : [ "string", "null" ],
              "enum" : [ "en", "ja", "zh", "es", "de", "fr", "tr", "ru", "pt", "it", "nl", "da", "sv", "pl", "ar", "he", "af", "cs", "fr-ca", "bg", "fi", "el", "hu", "id", "nb", "ro", "th", "uk", "vi", "ur", "hi", "te", "kn", "ta", "mr", "ko", "fa", "bn", "gu", "ms", "ml", "en-gb", "sk", "hr", "sl", "zh_TW", "zh-tw", "ca", "ka", "kk", "my", "km", "pt-br" ],
              "pattern" : "([a-zA-Z]{2,4}([-_][a-zA-Z]{2})?)"
            },
            "uniqueItems" : false
          },
          "name" : {
            "description" : "Name of the help center",
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : "^[0-9a-zA-Z\\!\\$\\|\\%&amp;\\#\\-\\*\\+\\,\\^\\_\\`\\~\\s\\.\\P{InBasicLatin}]+$"
          },
          "isEncodedPermalinkAllowed" : {
            "type" : [ "boolean", "null" ],
            "description" : "Indicates whether other language permalink setting is enabled. Possible values: true = enabled, false = disabled"
          },
          "id" : {
            "description" : "Unique ID of the help center",
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "departmentIds" : {
            "description" : "Department IDs associated with the help center",
            "type" : [ "array", "null" ],
            "items" : {
              "type" : [ "string", "integer", "null" ],
              "format" : "int64",
              "pattern" : "([0-9]+)"
            },
            "uniqueItems" : false
          },
          "isMultilingualEnabled" : {
            "type" : [ "boolean", "null" ],
            "description" : "Indicates whether multilingual settings are enabled. Possible values: true = multilingual enabled, false = multilingual disabled"
          },
          "helpCenterLocales" : {
            "description" : "Locale configuration entries for the help center",
            "$ref" : "#/components/schemas/helpcenterLocaleList"
          },
          "primaryLocale" : {
            "description" : "Primary locale of the help center",
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "[a-zA-Z]{2,4}([-_][a-zA-Z]{2})?"
          },
          "url" : {
            "description" : "URL of the help center portal",
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
          },
          "logoUrl" : {
            "description" : "URL of the help center logo",
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
          },
          "status" : {
            "description" : "Status of the help center. Possible values: ACTIVE, DISABLED",
            "type" : [ "string", "null" ],
            "enum" : [ "ACTIVE", "DISABLED" ]
          }
        },
        "required" : [ "departmentIds", "helpCenterLocales", "id", "isDefault", "isEncodedPermalinkAllowed", "isMultilingualEnabled", "locales", "logoUrl", "name", "primaryLocale", "status", "url" ]
      },
      "helpcenterDomain" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "name" : {
            "description" : "Domain name",
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "^([a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?\\.)+([a-zA-Z]{2,22})|([a-zA-Z]{2,22}:([0-9]{3,6})?)$"
          },
          "type" : {
            "description" : "Type of the domain. Possible values: PRIMARY, SECONDARY",
            "type" : [ "string", "null" ],
            "enum" : [ "PRIMARY" ]
          }
        },
        "required" : [ "name", "type" ]
      },
      "helpcenterDomainsList" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/helpcenterDomain"
        }
      }
    },
