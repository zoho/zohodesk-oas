{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "ContactDeduplication",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/groupContactDuplicateValues" : {
      "get" : {
        "tags" : [ "ContactDeduplication" ],
        "summary" : "Get Duplicate Contact Groups",
        "description" : "Retrieves duplicate contact groups, with pagination support.\n\n**Note:** If this API returns a `202` status code, there are `100,000` or more contacts in the help desk portal. In that scenario, the deduplication request is accepted and an automated report is sent to the user who initiated the request after processing completes.",
        "operationId" : "getDuplicateContactFieldValueCounts",
        "parameters" : [ {
          "name" : "fieldName",
          "in" : "query",
          "description" : "Name of the field whose values must be matched for deduplication. Possible values: firstName, lastName, email, secondaryEmail, phone, fullName, bothEmail",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "firstName", "lastName", "email", "secondaryEmail", "phone", "fullName", "bothEmail" ],
            "pattern" : "^(firstName|lastName|email|secondaryEmail|phone|fullName|bothEmail)"
          }
        }, {
          "name" : "swFieldValue",
          "in" : "query",
          "description" : "Key that specifies the letter with which the field values must start",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of contacts to fetch",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number starting from which the contacts must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "minimum" : 0,
            "pattern" : "([0-9]+)",
            "default" : 0
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Sorts contacts by the specified attribute. Possible values: count, fieldValue. Default sorting order is ascending. Prefix with - for descending.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "count", "fieldValue" ],
            "pattern" : "-?(count|fieldValue)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/listDuplicateContactCountResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "202" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.contacts.READ" ]
        } ]
      }
    },
