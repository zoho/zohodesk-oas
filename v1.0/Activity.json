{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Activity",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/activities/emptySpam" : {
      "post" : {
        "tags" : [ "Activity" ],
        "summary" : "Delete spam activities",
        "description" : "This API deletes all spam activities.",
        "operationId" : "deleteSpamActivities",
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/emptyActivitiesSpamResponse"
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "202" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.activities.calls.DELETE", "Desk.activities.events.DELETE", "Desk.activities.tasks.DELETE" ]
        } ]
      }
    },
    "/api/v1/tickets/{ticketId}/activities" : {
      "get" : {
        "tags" : [ "Activity" ],
        "summary" : "List ticket activities",
        "description" : "This API lists a particular number of activities associated with a ticket, based on the limit specified.",
        "operationId" : "getActivitiesForTicket",
        "parameters" : [ {
          "name" : "include",
          "in" : "query",
          "description" : "Allowed values are : contacts, assignee,tickets,teams,projects,integInfo.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "enum" : [ "contacts", "tickets", "assignee", "teams" ]
            },
            "uniqueItems" : true
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of activities to list",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number, starting from which the activities must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Sort by a specific attribute: @activityTime@ or @createdTime@.The default sorting order is ascending. A @-@ prefix denotes descending order of sorting.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "activityTime", "createdTime" ],
            "pattern" : "-?(createdTime|activityTime)"
          }
        }, {
          "name" : "isSpam",
          "in" : "query",
          "description" : "Key that denotes whether to fetch spam activities or not",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "boolean" ]
          }
        }, {
          "name" : "isCompleted",
          "in" : "query",
          "description" : "Key that denotes whether the activity is completed or not",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "boolean" ]
          }
        }, {
          "name" : "ticketId",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getActivitiesByRequestIdResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.activities.calls.READ", "Desk.activities.events.READ", "Desk.activities.tasks.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.calls.READ", "Desk.events.READ", "Desk.tasks.READ" ]
        } ]
      }
    },
    "/api/v1/activities" : {
      "get" : {
        "tags" : [ "Activity" ],
        "summary" : "List activities",
        "description" : "This API lists activities based on the limit specified.",
        "operationId" : "getActivitiesList",
        "parameters" : [ {
          "name" : "from",
          "in" : "query",
          "description" : "Index number, starting from which the activities must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of activities to list",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Department from which the activities need to be queried",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "viewId",
          "in" : "query",
          "description" : "ID of the view to apply while fetching the resources",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "departmentIds",
          "in" : "query",
          "description" : "Departments from which the tasks need to be queried",
          "required" : false,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : "array",
            "maxItems" : 20,
            "uniqueItems" : true,
            "items" : {
              "type" : [ "string", "integer" ],
              "format" : "int64",
              "pattern" : "([0-9]+)"
            }
          }
        }, {
          "name" : "assignee",
          "in" : "query",
          "description" : "Key that filters tickets by assignee. Values allowed are any valid assignee ID or multiple assignee IDs separated by commas.",
          "required" : false,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : "array",
            "maxItems" : 20,
            "uniqueItems" : true,
            "items" : {
              "type" : [ "string", "integer" ],
              "format" : "int64",
              "pattern" : "([0-9]+)"
            }
          }
        }, {
          "name" : "activityTime",
          "in" : "query",
          "description" : "Activity time for completing the activity. Values allowed are Overdue, Tomorrow, CurrentWeek, CurrentMonth and Today. You can pass multiple values by separating them with commas.",
          "required" : false,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : "array",
            "maxItems" : 10,
            "uniqueItems" : true,
            "items" : {
              "type" : "string",
              "maxLength" : 100,
              "enum" : [ "Overdue", "Today", "Tomorrow", "CurrentWeek", "CurrentMonth" ],
              "pattern" : "(Overdue|Today|Tomorrow|CurrentWeek|CurrentMonth)"
            }
          }
        }, {
          "name" : "include",
          "in" : "query",
          "description" : "Allowed values are : contacts, assignee, tickets, teams, projects, integInfo.",
          "required" : false,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : "array",
            "maxItems" : 6,
            "uniqueItems" : true,
            "items" : {
              "type" : "string",
              "maxLength" : 100,
              "enum" : [ "contacts", "assignee", "tickets", "teams", "projects", "integInfo" ],
              "pattern" : "(contacts|assignee|tickets|teams|projects|integInfo)"
            }
          }
        }, {
          "name" : "isCompleted",
          "in" : "query",
          "description" : "Key that denotes whether the activity is completed or not",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "boolean" ]
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Sort by a specific attribute: activityTime or createdTime. The default sorting order is ascending. A - prefix denotes descending order of sorting.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 100,
            "enum" : [ "category", "subject", "status", "createdTime", "modifiedTime", "priority", "activityTime", "activityType", "-category", "-subject", "-status", "-createdTime", "-modifiedTime", "-priority", "-activityTime", "-activityType" ],
            "pattern" : "-?(category|subject|status|createdTime|modifiedTime|priority|activityTime|activityType)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getActivitiesByRequestIdResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.activities.calls.READ", "Desk.activities.events.READ", "Desk.activities.tasks.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.calls.READ", "Desk.events.READ", "Desk.tasks.READ" ]
        } ]
      }
    }
  },
