          },
          "400" : {
            "$ref" : "./Common.json#/components/responses/badRequestErrorResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          },
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.InstantMessages.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/im/sessions/{id}/tickets" : {
      "get" : {
        "tags" : [ "IM_Session" ],
        "summary" : "Get Session Tickets",
        "description" : "Retrieves tickets associated with the specified IM session, with pagination support.",
        "operationId" : "getIMSessionTickets",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "Unique ID of the session.",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the session.",
            "maxLength" : 100,
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number, starting from which the tickets must be fetched.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of tickets to fetch. Defaults to 50 when omitted or zero. Maximum value is 50.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50,
            "minimum" : 0,
            "maximum" : 50
          }
        }, {
          "name" : "include",
          "in" : "query",
          "description" : "Additional information to include in the response. This is a list-based parameter; pass one or more comma-separated values. Possible values: contacts, products, isRead, departments, team, assignee, source, ability.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "^(contacts|products|isRead|departments|team|assignee|source|ability)(,(contacts|products|isRead|departments|team|assignee|source|ability))*$",
            "example" : "assignee,team",
            "maxLength" : 200,
            "minLength" : 0
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/getIMSessionTickets"
          },
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.InstantMessages.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/im/sessions" : {
      "get" : {
        "tags" : [ "IM_Session" ],
        "summary" : "List Sessions",
        "description" : "This API lists all sessions",
        "operationId" : "getSessions",
        "x-mcp-group" : [ "Initiate Session", "IM Messages" ],
        "x-mcp-ready" : true,
