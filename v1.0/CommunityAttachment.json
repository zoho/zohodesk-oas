{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "CommunityAttachment",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/communityAttachments" : {
      "post" : {
        "tags" : [ "CommunityAttachment" ],
        "summary" : "Upload Attachment",
        "description" : "Uploads a file to the storage space allocated for the community module.",
        "operationId" : "uploadCommunityAttachment",
        "x-mcp-ready" : false,
        "parameters" : [ {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : [ "object" ],
                "properties" : {
                  "file" : {
                    "type" : [ "string" ],
                    "format" : "binary",
                    "description" : "File to upload"
                  }
                },
                "required" : [ "file" ],
                "additionalProperties" : false
              }
            }
          }
        },
        "responses" : {
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/addAttachment"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "500" : {
            "$ref" : "./Common.json#/components/responses/internalErrorResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.forums.CREATE", "Desk.community.CREATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/communityAttachments/{id}/content" : {
      "get" : {
        "tags" : [ "CommunityAttachment" ],
        "summary" : "Get Unassociated Attachment",
        "description" : "Retrieves an unassociated attachment from the user community. Unassociated attachments are files uploaded to a community topic or comment that is not yet published or saved as a draft.",
        "operationId" : "getUnassociatedCommunityAttachment",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "description" : "Unique ID of the unassociated attachment to retrieve"
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "200" : {
            "$ref" : "./Common.json#/components/responses/fileResponse"
          },
          "500" : {
            "$ref" : "./Common.json#/components/responses/internalErrorResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.forums.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "addAttachmentResponse" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "size" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Size of the uploaded attachment in bytes"
          },
          "name" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "Name of the uploaded attachment file"
          },
          "id" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the uploaded attachment"
          },
          "href" : {
            "type" : [ "string", "null" ],
            "maxLength" : 200,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
          }
        },
        "required" : [ "href", "id", "name", "size" ]
      }
    },
    "responses" : {
      "addAttachment" : {
        "description" : "addAttachment template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/addAttachmentResponse"
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "size" : "1024",
                  "name" : "attachment.jpeg",
                  "id" : "1004"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "cookie-auth" : {
        "$ref" : "./Common.json#/components/securitySchemes/cookie-auth"
      },
      "org-oauth" : {
        "$ref" : "./Common.json#/components/securitySchemes/org-oauth"
      },
      "iam-oauth2-schema" : {
        "$ref" : "./Common.json#/components/securitySchemes/iam-oauth2-schema"
      }
    }
  },
  "x-entity" : "CommunityAttachment"
}