      "GetWhatsappPhoneNumbers_200": {
        "summary": "GET /api/v1/im/integrationServices/WHATSAPP/phonenumbers — phone numbers under a WABA",
        "description": "Typical 200 response: `data` lists WhatsApp phone numbers with connection status, verification details, quality, tier, throughput, and optional configurations and commerce settings.",
        "value": {
          "data": [
            {
              "nameVerificationStatus": "APPROVED",
              "configurations": [
                {
                  "subscribers": "ZOHO_DESK",
                  "name": "WA Channel",
                  "createdTime": "2025-11-19 07:44:49.536",
                  "isActive": true,
                  "channelId": 1234567890
                }
              ],
              "commerceSettings": {
                "isCartEnabled": false,
                "isCatalogVisible": false
              },
              "hasCertificate": true,
              "quality": "GREEN",
              "isOnBizApp": false,
              "phoneNumber": "+1234567890",
              "connectionMessage": "CONFIGURED_IN_CHANNEL",
              "tier": "TIER_100K",
              "connectionStatus": "CONNECTED",
              "canConnect": false,
              "id": "1234567890",
              "verifiedName": "Zoho Developer",
              "throughput": "STANDARD",
              "codeVerificationStatus": "EXPIRED"
            }
          ],
          "kind": "single.json"
        }
      },
      "CodeVerificationSuccess_200": {
        "summary": "OTP code verification success",
        "description": "Returned on successful OTP request (GET) or OTP submission (POST).",
        "value": {
          "success": true,
          "kind": "single.json"
        }
      },
      "CodeVerificationError_500_rateLimit": {
        "summary": "OTP rate limit exceeded",
        "description": "Returned when too many OTP attempts have been made.",
        "value": {
          "errorCode": "500",
          "message": "You have tried too many times. Please try again later."
        }
      },
      "CodeVerificationError_500_incorrectCode": {
        "summary": "Incorrect OTP code",
        "description": "Returned when the submitted OTP code is incorrect.",
        "value": {
          "errorCode": "500",
          "message": "Verify code failed: Incorrect code entered."
        }
      },
      "GetWhatsAppTemplateTags_200": {
        "summary": "GET /api/v1/im/integrationServices/WHATSAPP/templateTags — template categories",
        "description": "Typical 200: `data.tags` lists UTILITY and MARKETING; `kind` is `single.json`.",
        "value": {
          "data": {
            "tags": [
              "UTILITY",
              "MARKETING"
            ]
          },
          "kind": "single.json"
        }
      },
      "GetWhatsAppDetails_200": {
        "summary": "GET /api/v1/im/integrationServices/WHATSAPP/details — WABA and number status",
        "description": "Typical 200: aggregate `numberStatus`, per-WABA `wabaDetail`, root `wabaStatus`, and `kind` `single.json`.",
        "value": {
          "data": {
            "numberStatus": "ABSENT",
            "wabaDetail": [
              {
                "wabaId": "105492799180994",
                "name": "Zoho Desk Local",
                "businessId": "10155449143935384",
                "numberStatus": "PRESENT",
                "wabaStatus": "APPROVED"
              }
            ],
            "wabaStatus": "NONE"
          },
          "kind": "single.json"
        }
      },
      "GetIMIntegrationStatus_200_ACTIVE": {
        "summary": "GET /api/v1/im/account — IM integration is active",
        "description": "Typical 200 response when the Desk org is linked to Zoho IM. Returns status ACTIVE and the IM-side org identifier. PII masked with synthetic sample values.",
        "value": {
          "status": "ACTIVE",
          "imOrgId": "1234567890"
        }
      },
      "GetIMIntegrationStatus_200_DISABLED": {
        "summary": "GET /api/v1/im/account — IM integration is disabled",
        "description": "Response when the Desk org link to Zoho IM exists but is paused.",
        "value": {
          "status": "DISABLED",
          "imOrgId": "1234567890"
        }
      },
      "GetIMIntegrationStatus_200_NOT_CONFIGURED": {
        "summary": "GET /api/v1/im/account — IM is not configured",
        "description": "Response when the Desk org is not yet linked to Zoho IM. Complete IM setup from the Zoho Desk admin UI before calling other IM APIs.",
        "value": {
          "status": "NOT_CONFIGURED"
        }
      }
    }
