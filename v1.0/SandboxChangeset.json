            "$ref" : "./Sandbox.json#/components/schemas/sandboxModule",
            "description" : "Module in which the change was made"
          },
          "eventTime" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))",
            "description" : "Time at which the change was made (ISO 8601 format)"
          },
          "action" : {
            "$ref" : "./Sandbox.json#/components/schemas/changesetAction",
            "description" : "Action performed on the entity. Possible values: ADD, UPDATE, DELETE"
          },
          "externalId" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "External ID associated with the entity in the production environment"
          },
          "department" : {
            "$ref" : "./Sandbox.json#/components/schemas/sandboxDepartment",
            "description" : "Department in which the change was made"
          },
          "changeSetId" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the changeset"
          }
        },
        "required" : [ "action", "actor", "changeSetId", "department", "entity", "eventTime", "externalId", "module" ]
      },
      "changesetRespArray" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/changesetResponse"
