    "/api/v1/helpCenters" : {
      "get" : {
        "tags" : [ "Helpcenter" ],
        "summary" : "Get Help Centers",
        "description" : "Retrieves a list of help centers configured in the portal, with pagination support.",
        "operationId" : "getAllHelpCenters",
        "x-mcp-group" : [ "Help Center Customization" ],
        "parameters" : [ {
          "name" : "from",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "minimum" : 1,
            "default" : 1
          },
          "style" : "form",
          "explode" : true,
          "description" : "Index number starting from which the help centers must be listed"
        }, {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "minimum" : 1,
            "maximum" : 50
          },
          "style" : "form",
          "explode" : true,
          "description" : "Number of help centers to list"
        }, {
          "name" : "skipPermissionCheck",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "boolean" ]
          },
          "style" : "form",
          "explode" : true,
          "description" : "Bypass permission validation for the request"
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        }, {
          "name" : "include",
          "in" : "query",
          "description" : "Additional information to include in the response. Possible values: translateSettings",
          "required" : false,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "translateSettings" ],
            "pattern" : "(translateSettings)"
          }
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/helpcenterListViewResponse"
          },
          "500" : {
            "$ref" : "./Common.json#/components/responses/internalErrorResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.READ", "Desk.channels.helpcenter.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.settings.READ" ]
        } ]
      }
    },
