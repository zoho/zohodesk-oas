          "required" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "pattern" : "^([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s()]+|\\$\\{OPEN\\}|\\$\\{ONHOLD\\}|\\$\\{CLOSED\\})$",
              "x-regex-name" : "ticketStatusPicklistAPI"
            },
            "maxItems" : 20
          },
          "style" : "form",
          "explode" : true,
          "description" : "Resolution status of the tickets. Note: Multiple values can be provided by separating them with commas."
        }, {
          "name" : "receivedInDays",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "15", "30", "90", "-1" ]
          },
          "style" : "form",
          "explode" : true,
          "description" : "Number of days since the tickets were received. Possible values: 15, 30, 90"
        }, {
          "name" : "priority",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\:\\/\\!\\P{InBasicLatin}\\s()]+",
              "x-regex-name" : "picklistValue"
            },
            "maxItems" : 20
          },
          "style" : "form",
          "explode" : true,
          "description" : "Priority of the tickets. Note: Multiple values can be provided by separating them with commas."
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of tickets to fetch",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 100
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which tickets must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "sortBy",
          "in" : "query",
          "description" : "Sorts tickets by a specific attribute. Possible values: dueDate, recentThread, createdTime, ticketNumber. Note: Default sorting order is ascending. Prefix with - for descending.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "createdTime", "modifiedTime", "dueDate", "recentThread", "ticketNumber" ],
            "pattern" : "-?(ticketNumber|dueDate|createdTime|recentThread|modifiedTime)"
