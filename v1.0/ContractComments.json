                  "maxLength" : 100,
                  "minLength" : 0
                },
                "content" : {
                  "type" : "string",
                  "description" : "Content of the comment. Maximum 32000 characters. To set user mentions, use the format zsu[user-zuid]zsu (replace user-zuid with the user's zuid).",
                  "maxLength" : 32000,
                  "minLength" : 0
                },
                "attachmentIds" : {
                  "type" : "array",
                  "description" : "List of file attachment IDs to include in the comment. Each ID corresponds to an attachment previously uploaded via the Upload Attachment API.",
