                  "maxLength" : 50,
                  "minLength" : 0
                },
                "lastName" : {
                  "type" : [ "string", "null" ],
                  "maxLength" : 50,
                  "minLength" : 0
                },
                "photoURL" : {
                  "type" : [ "string", "null" ],
                  "maxLength" : 100,
                  "minLength" : 0,
                  "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
                },
                "id" : {
                  "type" : [ "string", "integer", "null" ],
                  "format" : "int64",
                  "pattern" : "([0-9]+)"
                },
                "type" : {
                  "type" : [ "string", "null" ],
                  "enum" : [ "END_USER", "AGENT" ]
                }
              },
              "required" : [ "firstName", "id", "lastName", "photoURL", "type" ]
            },
            "examples" : {
