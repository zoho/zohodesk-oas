    "/api/v1/roles" : {
      "get" : {
        "tags" : [ "Role" ],
        "summary" : "Get Roles",
        "description" : "Retrieves roles in the help desk portal, with pagination support.",
        "operationId" : "getRoles",
        "parameters" : [ {
          "name" : "isDefault",
          "in" : "query",
          "description" : "Filters roles according to whether they are default or custom roles",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "boolean" ]
          }
        }, {
          "name" : "searchStr",
          "in" : "query",
          "description" : "Searches roles by name or description. <p><b>Note:</b> The string must contain at least one character. Supported search methods are string* for starts with, *string* for contains, and string for exact match.</p>",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "minLength" : 1,
            "pattern" : "[0-9a-zA-Z_\\-\\&\\.\\$\\@\\^\\(\\)\\{\\}\\~\\=\\-\\|\\*\\+\\?\\[\\]\\,\\:\\\"\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of roles to display",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 500,
            "pattern" : "([0-9]+)",
            "minimum" : 0
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which the roles must be listed",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "minimum" : 0,
            "pattern" : "([0-9]+)",
            "default" : 0
          }
        }, {
          "name" : "isVisible",
          "in" : "query",
          "description" : "Filters roles according to their visibility in the UI",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "boolean" ]
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
