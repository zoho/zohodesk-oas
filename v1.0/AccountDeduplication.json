            "schema" : {
              "type" : [ "object", "null" ],
              "additionalProperties" : false,
              "properties" : {
                "fieldName" : {
                  "description" : "Name of the default field set for account deduplication. Accepted values: email, phone, accountName",
                  "type" : [ "string", "null" ],
                  "enum" : [ "email", "phone", "accountName", null ]
                }
              },
              "required" : [ "fieldName" ]
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "fieldName" : "email"
                }
              }
            }
          }
        }
      },
      "listDuplicateAccountsCountsResponse" : {
