      "patch" : {
        "tags" : [ "IM_Session" ],
        "summary" : "Update a session",
        "description" : "This API updates details of a session, including its status and assignee. Use it to assign the session to yourself or another agent by passing agentId with an appropriate status value. To assign a bot, pass botId with deskBotId from List IM Bots. Status changes must follow allowed transitions from the current session status. From any status, you can transition to BLOCKED or ENDED. Additional transitions are allowed based on the current status: from BLOCKED to OPEN; from OPEN to ON_HOLD; from ON_PROGRESS to ENDED; from ENDED to ON_HOLD. An invalid status transition returns a validation error.",
        "operationId" : "updateSession",
        "x-mcp-group" : [ "IM Messages" ],
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "Unique ID of the session.",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Unique ID of the session.",
            "maxLength" : 100,
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/updateSession"
        },
        "responses" : {
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getSession"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "400" : {
            "$ref" : "./Common.json#/components/responses/badRequestErrorResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.InstantMessages.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
