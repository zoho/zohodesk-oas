            "description" : "Background color of the badge.",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "^#?(([a-fA-F0-9]){3}){1,2}$"
          },
          "shape" : {
            "type" : [ "string", "null" ],
            "description" : "Shape of the badge.",
