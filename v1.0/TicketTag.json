          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "pattern" : "^([0-9]+|Unassigned)$"
            },
            "maxItems" : 20
          },
          "style" : "form",
          "explode" : true,
          "description" : "Agent assigned to resolve the ticket. Possible values: Unassigned, assigneeId. Note: Multiple values can be provided by separating them with commas."
        }, {
          "name" : "channel",
          "in" : "query",
          "required" : false,
