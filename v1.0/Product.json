    "/api/v1/products" : {
      "get" : {
        "tags" : [ "Product" ],
        "summary" : "Get Products",
        "description" : "This API lists a specific number of products from your help desk portal, based on the limit defined. This API does not support filtering by product name; to find products by name, use the searchProductDuplicates operation. (Note: The departmentIds key will soon be deprecated and not included in API responses.)",
