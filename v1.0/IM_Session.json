      "get" : {
        "tags" : [ "IM_Session" ],
        "summary" : "Get Session Metrics",
        "description" : "Returns session counts grouped by assignee filter and session status. Use optional query parameters to narrow results by department, channel, or integration service.",
        "operationId" : "getSessionMetrics",
        "x-mcp-group" : [ "IM Metrics" ],
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Filter conversations of all channels in given department",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "description" : "Filter conversations of all channels in given department",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "integrationServiceId",
          "in" : "query",
          "description" : "Integration service ID to filter session metrics. Possible values: TELEGRAM, TWILIO, IM_TALK, LINE, WECHAT, WECOM, WHATSAPP, FACEBOOKMESSENGER, INSTAGRAM.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Integration service ID to filter session metrics. Possible values: TELEGRAM, TWILIO, IM_TALK, LINE, WECHAT, WECOM, WHATSAPP, FACEBOOKMESSENGER, INSTAGRAM.",
            "enum" : [ "TELEGRAM", "TWILIO", "IM_TALK", "LINE", "WECHAT", "WECOM", "WHATSAPP", "FACEBOOKMESSENGER", "INSTAGRAM" ],
            "maxLength" : 100,
            "minLength" : 0
          }
        }, {
          "name" : "channelId",
          "in" : "query",
          "description" : "Filter conversations of a channel",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "description" : "Filter conversations of a channel",
            "pattern" : "^([0-9]+)(,([0-9]+)){0,49}$",
            "maxLength" : 1000,
            "minLength" : 0
          }
        }, {
          "name" : "excludeSyncingChannels",
          "in" : "query",
          "description" : "Exclude session of channels which are in syncing status",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "boolean",
            "description" : "Exclude session of channels which are in syncing status"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
