  "components" : {
    "schemas" : {
      "templatesCount" : {
        "type" : [ "array" ],
        "items" : {
          "type" : [ "object" ],
          "properties" : {
            "templateType" : {
              "type" : [ "string" ],
              "description" : "Type of template.",
              "enum" : [ "Email", "SMS" ]
            },
            "count" : {
              "type" : [ "object" ],
              "description" : "Module-wise count of templates in the folder.",
              "properties" : {
                "tickets" : {
                  "description" : "Count of templates for the Tickets module.",
                  "$ref" : "#/components/schemas/count"
                },
                "calls" : {
                  "description" : "Count of templates for the Calls module.",
                  "$ref" : "#/components/schemas/count"
                },
                "solutions" : {
                  "description" : "Count of templates for the Solutions (Knowledge Base) module.",
                  "$ref" : "#/components/schemas/count"
                },
                "accounts" : {
                  "description" : "Count of templates for the Accounts module.",
                  "$ref" : "#/components/schemas/count"
                },
                "tasks" : {
                  "description" : "Count of templates for the Tasks module.",
                  "$ref" : "#/components/schemas/count"
                },
                "contacts" : {
                  "description" : "Count of templates for the Contacts module.",
                  "$ref" : "#/components/schemas/count"
                },
                "events" : {
                  "description" : "Count of templates for the Events module.",
                  "$ref" : "#/components/schemas/count"
                },
                "products" : {
                  "description" : "Count of templates for the Products module.",
                  "$ref" : "#/components/schemas/count"
                }
              },
              "required" : [ "events", "products", "contacts", "tasks", "accounts", "solutions", "calls", "tickets" ]
            }
          },
          "required" : [ "templateType", "count" ]
        }
      },
      "count" : {
        "type" : "string",
        "pattern" : "([0-9]+)",
        "format" : "int32"
      },
      "templateFolderResponse" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "folderDesc" : {
            "type" : [ "string", "null" ],
            "description" : "Description of the template folder.",
            "maxLength" : 32000,
            "minLength" : 0
          },
          "modifiedOn" : {
            "type" : [ "string", "null" ],
            "description" : "Time at which the template folder was last modified.",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))"
          },
          "createdBy" : {
            "type" : [ "string", "null" ],
            "description" : "Unique ID of the user who created the template folder.",
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "folderAccessDetails" : {
            "type" : [ "object", "null" ],
            "description" : "Access configuration of the template folder.",
            "additionalProperties" : false,
            "maxProperties" : 5,
            "minProperties" : 5,
            "properties" : {
              "teams" : {
                "type" : [ "array", "null" ],
                "description" : "Teams with access to the folder.",
                "items" : {
                  "type" : [ "string", "null" ],
                  "format" : "int64",
                  "pattern" : "([0-9]+)"
                },
                "uniqueItems" : false
              },
              "roles" : {
                "type" : [ "array", "null" ],
                "description" : "Roles with access to the folder.",
                "items" : {
                  "type" : [ "string", "null" ],
                  "format" : "int64",
                  "pattern" : "([0-9]+)"
                },
                "uniqueItems" : false
              },
              "type" : {
                "type" : [ "string", "null" ],
                "description" : "Accessibility type of the template folder.",
                "enum" : [ "onlyMe", "allAgents", "restrictedAccess" ]
              },
              "rolesAndSubordinates" : {
                "type" : [ "array", "null" ],
                "description" : "Roles and subordinates with access to the folder.",
                "items" : {
                  "type" : [ "string", "null" ],
                  "format" : "int64",
                  "pattern" : "([0-9]+)"
                },
                "uniqueItems" : false
              },
              "agents" : {
                "type" : [ "array", "null" ],
                "description" : "Agents with access to the folder.",
                "items" : {
                  "type" : [ "string", "null" ],
                  "format" : "int64",
                  "pattern" : "([0-9]+)"
                },
                "uniqueItems" : false
              }
            },
            "required" : [ "agents", "roles", "rolesAndSubordinates", "teams", "type" ]
          },
          "departmentId" : {
            "type" : [ "string", "null" ],
            "description" : "Unique ID of the department associated with the folder.",
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "modifiedBy" : {
            "type" : [ "string", "null" ],
            "description" : "Unique ID of the user who last modified the template folder.",
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "folderName" : {
            "type" : [ "string", "null" ],
            "description" : "Name of the template folder.",
            "maxLength" : 250,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+"
          },
          "category" : {
            "type" : [ "string", "null" ],
            "description" : "Category of the template folder.",
            "enum" : [ "CUSTOM_FOLDER", "DEFAULT_FOLDER" ]
          },
          "createdOn" : {
            "type" : [ "string", "null" ],
            "description" : "Time at which the template folder was created.",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))"
          },
          "folderId" : {
            "type" : [ "string", "null" ],
            "description" : "Unique ID of the template folder.",
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "templatesCount" : {
            "description" : "Template count details grouped by template type.",
            "$ref" : "#/components/schemas/templatesCount"
          }
        },
        "required" : [ "category", "createdBy", "createdOn", "departmentId", "folderAccessDetails", "folderDesc", "folderId", "folderName", "modifiedBy", "modifiedOn" ]
      }
    },
