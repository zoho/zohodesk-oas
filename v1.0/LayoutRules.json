        "operationId" : "createLayoutRule",
        "parameters" : [ {
          "name" : "include",
          "in" : "query",
          "description" : "Additional information related to the rule. Possible values: creator, modifier.",
          "required" : false,
          "style" : "form",
          "explode" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "enum" : [ "creator", "modifier" ],
              "description" : "Accepted values: creator, modifier"
            },
            "maxItems" : 2
          }
        }, {
          "name" : "layoutId",
