      "get" : {
        "tags" : [ "Team" ],
        "summary" : "Get Teams in Department",
        "description" : "Retrieves details of all teams in a specific department, with pagination support.",
        "operationId" : "getTeamsInDepartment",
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the department"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "integer",
            "default" : 0,
            "minimum" : 0
          },
          "description" : "Zero-based index number starting from which the teams must be fetched"
        }, {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "integer",
            "default" : 0,
            "minimum" : 0,
            "maximum" : 200
          },
          "description" : "Number of teams to fetch\n\nNote: If limit is omitted or set to 0, the API returns all teams with no upper bound."
        }, {
          "name" : "searchStr",
          "in" : "query",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string"
          },
          "description" : "Search string used to filter teams by name."
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/teamListResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.READ", "Desk.departments.READ", "Desk.settings.READ", "Desk.teams.READ" ]
        } ],
        "x-audience" : [ "external-public" ],
        "x-mcp-ready" : true
      }
    },
