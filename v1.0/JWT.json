  "components" : {
    "schemas" : {
      "secretKeySchema" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "secretKey" : {
            "description" : "JWT secret key associated with the help center",
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "secretKey" ]
      },
      "jwtResponseSchema" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "helpcenterId" : {
            "description" : "Unique ID of the help center associated with the JWT configuration",
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "loginURL" : {
            "description" : "Login URL used for JWT authentication",
            "type" : [ "string", "null" ],
            "maxLength" : 1000,
            "minLength" : 0,
            "pattern" : "^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&%\\$#_@]*)?$"
          },
          "logoutURL" : {
            "description" : "Logout URL used for JWT authentication",
            "type" : [ "string", "null" ],
            "maxLength" : 1000,
            "minLength" : 0,
            "pattern" : "^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&%\\$#_@]*)?$"
          },
          "zaId" : {
            "description" : "Zoho account ID associated with the JWT configuration",
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0
          },
          "status" : {
            "description" : "Activation status of the JWT configuration. Possible values: ACTIVE, DISABLED",
            "type" : [ "string", "null" ],
            "enum" : [ "ACTIVE", "DISABLED" ]
          }
        },
        "required" : [ "helpcenterId", "loginURL", "logoutURL", "status", "zaId" ]
      },
      "jwtRequestSchema" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "maxLength" : 2000,
        "minProperties" : 1,
        "properties" : {
          "loginURL" : {
            "description" : "Login URL used for JWT authentication",
            "type" : [ "string" ],
            "maxLength" : 1000,
            "pattern" : "^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&%\\$#_@]*)?$"
          },
          "logoutURL" : {
            "description" : "Logout URL used for JWT authentication",
            "type" : [ "string" ],
            "maxLength" : 1000,
            "pattern" : "^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&%\\$#_@]*)?$"
          }
        },
        "required" : [ "loginURL", "logoutURL" ]
      },
      "updateJwtRequestSchema" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "maxLength" : 2050,
        "minProperties" : 1,
        "properties" : {
          "loginURL" : {
            "description" : "Login URL used for JWT authentication",
            "type" : [ "string" ],
            "maxLength" : 1000,
            "pattern" : "^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&%\\$#_@]*)?$"
          },
          "logoutURL" : {
            "description" : "Logout URL used for JWT authentication",
            "type" : [ "string" ],
            "maxLength" : 1000,
            "pattern" : "^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&%\\$#_@]*)?$"
          },
          "status" : {
            "description" : "Activation status of the JWT configuration. Possible values: ACTIVE, DISABLED",
            "type" : [ "string" ],
            "maxLength" : 100,
            "enum" : [ "ACTIVE", "DISABLED" ]
          }
        }
      }
