        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "condition" : {
            "type" : [ "string" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "Operator used for the condition. Valid operators depend on the field type: text, picklist, and lookup support is, isn't, starts with, contains, doesn't contain, ends with, is empty, is not empty; date supports is, isn't, is after, is before, is empty, is not empty; dateTime additionally supports between and not between; integer and currency support =, <>, <, <=, >, >=, is empty, is not empty; boolean supports is. Call Get Criteria Fields for Layout Rules to get the exact operators allowed for a specific field."
          },
          "fieldName" : {
            "type" : [ "string" ],
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "API name of a module field used in the condition. The field must exist on the module. For lookups, use the flat field API name."
          },
          "value" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "maxLength" : 1000,
              "minLength" : 0
            },
            "maxItems" : 50,
            "description" : "Value(s) used for the condition. For lookup fields, pass the related record display name, not the record ID. For is empty and is not empty, the value is the ${EMPTY} or ${NOTEMPTY} token. dateTime conditions may use ${CURRENTTIME} in place of a timestamp. Boolean fields use true or false."
          }
        },
        "required" : [ "condition", "fieldName", "value" ]
      },
      "requestConditionsArr" : {
        "type" : [ "array" ],
        "items" : {
          "$ref" : "#/components/schemas/requestConditions"
        },
        "maxItems" : 1000
      },
      "requestFieldConditions" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "pattern" : {
            "type" : [ "string" ],
            "maxLength" : 200,
            "minLength" : 0,
            "description" : "Expression that combines this branch's conditions by index (1 is the first condition). Criterion 1 must be ANDed at the root -- for example (1 and 2) or (1 and (2 or 3)). A single condition may be just 1. Root OR patterns such as (1 or 2) are invalid; use multiple fieldConditions branches instead.",
            "example" : [ "(1 and 2)", "(1 and (2 or 3))" ]
          },
          "name" : {
            "type" : [ "string" ],
            "maxLength" : 200,
            "minLength" : 0,
            "description" : "Name of the field condition block"
          },
          "conditions" : {
            "$ref" : "#/components/schemas/requestConditionsArr",
            "description" : "Conditions in this branch. The first condition must use the rule primary field (fieldName)."
          },
          "actions" : {
            "$ref" : "#/components/schemas/actions",
            "description" : "Actions executed when the condition block matches"
          }
        },
        "required" : [ "actions", "conditions", "name", "pattern" ]
      },
      "requestFieldConditionsArr" : {
        "type" : [ "array" ],
        "items" : {
          "$ref" : "#/components/schemas/requestFieldConditions"
        },
        "maxItems" : 1000
      },
      "layoutRuleResponseSchema" : {
        "type" : [ "object" ],
        "additionalProperties" : false,
        "properties" : {
          "id" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the layout rule"
          },
          "displayLabel" : {
            "type" : [ "string", "null" ],
            "maxLength" : 250,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "Display label of the primary field used to create the rule"
          },
          "modifiedTime" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "(((19|20)\\d\\d)[-/.]{1}(0?[1-9]|1[012])[-/.]{1}(0?[1-9]|[12][0-9]|3[01])(T)([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]([/.][\\d]{0,3})?(Z))",
            "description" : "Time at which the rule was modified"
          },
          "fieldConditions" : {
            "$ref" : "#/components/schemas/fieldConditionsArr",
            "description" : "Independent branch conditions. Each entry is evaluated separately and runs its own actions when matched. Use multiple branches for alternate criterion trees; combine conditions within a branch only via that branch's pattern."
          },
          "fieldName" : {
            "type" : [ "string", "null" ],
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+",
            "description" : "API name of the primary module field for this rule. Every fieldConditions[].conditions[0].fieldName must equal this value."
          },
          "description" : {
            "type" : [ "string", "null" ],
            "maxLength" : 255,
            "minLength" : 0,
            "description" : "Short description of the rule"
          },
          "systemGenerated" : {
            "type" : [ "boolean", "null" ],
            "description" : "Indicates whether the rule is system-generated. Possible values: true = system-generated rule; false = user-defined rule."
          },
          "layoutId" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the layout associated with the rule"
          },
          "executeInHelpCentre" : {
