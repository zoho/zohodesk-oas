    },
    "requestBodies" : {
      "setDefaultField" : {
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object" ],
              "additionalProperties" : false,
              "properties" : {
                "fieldName" : {
                  "description" : "Name of the field to set as the default for deduplication. Accepted values: email, phone, accountName",
                  "type" : [ "string" ],
                  "enum" : [ "email", "phone", "accountName" ],
                  "pattern" : "^(email|phone|accountName)"
                },
                "markDefault" : {
                  "description" : "Indicates whether to set or remove the field as the default. Accepted values: true = set the field as default, false = remove the field from default",
                  "type" : [ "boolean" ]
                }
              },
              "required" : [ "fieldName", "markDefault" ]
            },
            "examples" : {
              "Valid requestBody Definitions" : {
                "value" : {
                  "fieldName" : "accountName",
                  "markDefault" : true
                }
              }
            }
          }
        }
      }
