            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.UPDATE", "Desk.settings.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/starredViews/order" : {
      "put" : {
        "tags" : [ "StarredView" ],
        "summary" : "Reorder Starred Views",
        "description" : "This API helps reorder the starred views in a module.",
        "operationId" : "updateStarredViewOrder",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "module",
          "in" : "query",
          "description" : "Module associated with the view. Possible values: tickets, tasks, contacts, accounts, calls, events, activities, contracts",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "tickets", "tasks", "contacts", "accounts", "calls", "events", "activities", "contracts" ],
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department in which the view is configured",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]*|null|undefined)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/starredViewJsonOrder"
        },
        "responses" : {
