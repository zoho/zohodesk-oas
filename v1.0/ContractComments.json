                    "type" : "string",
                    "format" : "int64",
                    "description" : "ID of the attachment to be associated with the comment",
                    "pattern" : "([0-9]+)"
                  }
                }
              },
              "required" : [ "content" ]
            },
            "examples" : {
              "Valid requestBody Definitions" : {
