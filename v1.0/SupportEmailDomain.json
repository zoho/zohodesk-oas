        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "supportEmailDomain" : {
            "description" : "Name of the new email sub domain",
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "[a-z0-9]+"
