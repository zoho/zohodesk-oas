          "500" : {
            "$ref" : "./Common.json#/components/responses/internalErrorResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          },
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.forums.READ", "Desk.community.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      },
      "patch" : {
        "tags" : [ "CommunityUser" ],
        "summary" : "Update User Status",
        "description" : "Updates the moderation status of an end-user in the community.",
        "operationId" : "updateCommunityUserInfo",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "userId",
          "in" : "path",
          "required" : true,
          "description" : "Unique ID of the community user to update",
          "schema" : {
            "$ref" : "#/components/schemas/userIdSchema"
          },
          "style" : "simple",
          "explode" : false
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "$ref" : "#/components/requestBodies/updateCommunityUserInfoRequestJSON"
        },
        "responses" : {
          "404" : {
            "$ref" : "./Common.json#/components/responses/urlNotFoundErrorResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "500" : {
            "$ref" : "./Common.json#/components/responses/internalErrorResponse"
          },
          "204" : {
            "$ref" : "#/components/responses/emptyResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.forums.UPDATE", "Desk.community.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/communityUsers/{userId}/followers" : {
      "get" : {
        "tags" : [ "CommunityUser" ],
        "summary" : "Get User Followers",
        "description" : "Retrieves users who follow a community user, with pagination support.",
        "operationId" : "getAllCommunityUserFollowers",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of followers to list",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 50,
            "minimum" : 1,
            "pattern" : "([0-9]+)",
            "default" : 10
          }
        }, {
          "name" : "from",
          "in" : "query",
          "required" : false,
          "description" : "Index number from which followers must be listed",
          "schema" : {
            "$ref" : "#/components/schemas/fromSchema"
          },
          "style" : "form",
          "explode" : true
        }, {
          "name" : "userId",
          "in" : "path",
          "required" : true,
          "description" : "Unique ID of the community user from which followers must be retrieved",
          "schema" : {
            "$ref" : "#/components/schemas/userIdSchema"
          },
          "style" : "simple",
          "explode" : false
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/listAllCommunityUserFollowers"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.forums.READ", "Desk.community.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
