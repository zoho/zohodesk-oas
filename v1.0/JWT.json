        "tags" : [ "JWT" ],
        "summary" : "Get JWT Secret Key",
        "description" : "Retrieves the JWT secret key mapped with the specified help center.",
        "operationId" : "getSecretKey",
        "parameters" : [ {
          "name" : "helpcenterId",
          "description" : "Unique ID of the help center",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/secretKey"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.channels.helpcenter.READ" ]
        } ]
      }
    },
