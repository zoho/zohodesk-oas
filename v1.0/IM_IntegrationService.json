              },
              "LINE" : {
                "$ref" : "./examples/IM_IntegrationService.json#/components/examples/GetIntegrationService_LINE_200"
              },
              "WECHAT" : {
                "$ref" : "./examples/IM_IntegrationService.json#/components/examples/GetIntegrationService_WECHAT_200"
              },
              "WECOM" : {
                "$ref" : "./examples/IM_IntegrationService.json#/components/examples/GetIntegrationService_WECOM_200"
              }
            }
          }
        }
      },
      "getAvailableIntegrations" : {
        "description" : "200 response for GET /api/v1/im/integrationServices: paginated list of integration service types (`data`, `kind`, `hasMore`) available to the org.",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/getAvailableIntegrations_responseBody"
            },
            "examples" : {
              "GetAvailableIntegrations_200" : {
                "$ref" : "./examples/IM_IntegrationService.json#/components/examples/GetAvailableIntegrations_200"
              }
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "cookie-auth" : {
        "$ref" : "./Common.json#/components/securitySchemes/cookie-auth"
