        "summary" : "Get Sandbox Deployment Logs",
        "description" : "Retrieves deployment logs for a sandbox, with pagination support.",
        "operationId" : "getDeploymentLogs",
        "x-mcp-group" : [ "Sandbox Deployment" ],
        "parameters" : [ {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of deployment logs to fetch. The default value and the maximum value allowed is 50",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "maximum" : 50,
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "default" : 50
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which the deployment logs must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "default" : 1
          }
        }, {
          "$ref" : "./Sandbox.json#/components/parameters/sandboxId"
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/getDeploymentLogs"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
