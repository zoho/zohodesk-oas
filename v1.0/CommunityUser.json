        "description" : "Retrieves the details of a community user.",
        "operationId" : "getCommunityUserInfo",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "include",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "string" ],
            "pattern" : "stats",
            "maxItems" : 1
          },
          "style" : "form",
          "explode" : true,
          "description" : "Additional information to include in the response. Possible values: stats."
        }, {
          "name" : "userId",
          "in" : "path",
          "required" : true,
          "description" : "Unique ID of the community user to retrieve",
          "schema" : {
            "$ref" : "#/components/schemas/userIdSchema"
          },
          "style" : "simple",
          "explode" : false
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/userInfo"
