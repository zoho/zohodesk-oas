  "paths" : {
    "/api/v1/lastAccessedView/{cvId}" : {
      "put" : {
        "tags" : [ "CustomView" ],
        "summary" : "Update Last Accessed View",
        "description" : "Updates the view last accessed by the user in the module and department specified in the request.",
        "operationId" : "updateRecentView",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department in which the view is configured",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]*|null|undefined)"
          }
        }, {
          "name" : "cvId",
          "in" : "path",
          "description" : "Unique ID of the view",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/lastAccessedView" : {
      "get" : {
        "tags" : [ "CustomView" ],
        "summary" : "Get Last Accessed View",
        "description" : "Retrieves the view last accessed by the user in the module and department specified in the request.",
        "operationId" : "getRecentView",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department in which the view is configured",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]*|null|undefined)"
          }
        }, {
          "name" : "module",
          "in" : "query",
          "description" : "Module associated with the view. Possible values: tickets, tasks, contacts, accounts, products, activities, calls, events",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "tickets", "tasks", "contacts", "accounts", "calls", "events", "activities", "contracts" ],
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/getRecentViewJson"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/views" : {
      "get" : {
        "tags" : [ "CustomView" ],
        "summary" : "Get Views",
        "description" : "Retrieves a list of views configured for a specific module in your help desk portal, with pagination support.",
        "operationId" : "getViews",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "module",
          "in" : "query",
          "description" : "Module name for which the views are configured and need to be fetched",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "tickets", "contacts", "events", "activities", "tasks", "contracts", "accounts", "calls" ],
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department in which the view is configured",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]*|null|undefined)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        }, {
          "name" : "featureFlags",
          "in" : "header",
          "description" : "Optional flags to include extra details in the response. Possible values: createdBy. Use a comma-separated list to pass more than one.",
          "required" : false,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string" ],
            "const" : "createdBy"
          }
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/getViewsResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/unprocessableEntityErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.settings.READ", "Desk.basic.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
