      "getStarredViewsResponse" : {
        "description" : "getStarredViewsResponse template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object" ],
              "additionalProperties" : false,
              "properties" : {
                "starredViews" : {
                  "description" : "List of starred view entries",
                  "$ref" : "#/components/schemas/starredViewResponseArray"
                },
                "module" : {
                  "description" : "Module associated with the starred views",
                  "type" : [ "string", "null" ],
                  "enum" : [ "tickets", "tasks", "contracts", "accounts", "contacts", "calls", "events", "activities" ]
                }
              },
              "required" : [ "module", "starredViews" ]
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "starredViews" : [ {
                    "id" : "1000000044498",
                    "name" : "All Cases",
                    "viewName" : "All Cases",
                    "isCustomView" : false,
                    "isLocked" : false,
                    "deprecatedViewId" : "1000000033028"
                  } ],
                  "module" : "tickets"
                }
              }
            }
          }
        }
      }
