      "post" : {
        "tags" : [ "Sandbox" ],
        "summary" : "Rebuild Sandbox",
        "description" : "Rebuilds a specific sandbox by copying the current setup configuration data from the production environment to the sandbox. Note: Rebuilding the sandbox deletes all undeployed changes in the sandbox. You can rebuild a sandbox a maximum of three times per day. While a sandbox create, rebuild, or deploy operation is in progress, requests to start any of these operations are rejected. You can start another one only after the current operation completes.",
        "operationId" : "rebuildSandbox",
        "parameters" : [ {
          "name" : "sandboxId",
          "in" : "path",
          "description" : "Unique ID of the sandbox",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "400" : {
            "$ref" : "#/components/responses/sandboxActionRestrictionResponse"
          },
          "403" : {
            "$ref" : "./Common.json#/components/responses/forbiddenErrorResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.sandbox.UPDATE" ]
        } ]
      }
    },
