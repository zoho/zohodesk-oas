      "samlResponse" : {
        "description" : "samlResponse template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object" ],
              "additionalProperties" : false,
              "properties" : {
                "isSignupEnabled" : {
                  "description" : "Indicates whether new user registration via SAML is enabled.\n\nPossible values:\n • true = new user registration is enabled\n • false = new user registration is disabled",
                  "type" : [ "boolean" ]
                },
                "samlLogoutURL" : {
                  "description" : "SAML logout URL of the identity provider",
                  "type" : [ "string" ],
                  "maxLength" : 250,
                  "minLength" : 0,
                  "pattern" : "(^https\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
                },
                "samlLoginURL" : {
                  "description" : "SAML login URL of the identity provider",
                  "type" : [ "string" ],
                  "maxLength" : 250,
                  "minLength" : 0,
                  "pattern" : "(^https\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)"
                },
                "issuer" : {
                  "description" : "Issuer identifier for the SAML configuration",
                  "type" : [ "string" ],
                  "maxLength" : 100,
                  "minLength" : 0
                },
                "algorithm" : {
                  "description" : "Encryption algorithm used for SAML authentication",
                  "type" : [ "string" ],
                  "enum" : [ "RSA" ],
                  "maxLength" : 100,
                  "minLength" : 0
                },
                "status" : {
                  "description" : "Current status of the SAML configuration.\n\nPossible values: ENABLED, DISABLED",
                  "type" : [ "string" ],
                  "enum" : [ "ENABLED", "DISABLED" ],
                  "maxLength" : 100,
                  "minLength" : 0
                }
              },
              "required" : [ "algorithm", "isSignupEnabled", "issuer", "samlLoginURL", "samlLogoutURL", "status" ]
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "isSignupEnabled" : "false",
                  "samlLogoutURL" : "https://zylker.onelogin.com/trust/saml2/http-post/sso/9032",
                  "samlLoginURL" : "https://zylker.onelogin.com/trust/saml2/http-post/sso/9032",
                  "issuer" : "zoho.com",
                  "algorithm" : "RSA",
                  "status" : "ENABLED"
