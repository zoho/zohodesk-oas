          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.UPDATE", "Desk.settings.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/starredViews" : {
      "get" : {
        "tags" : [ "StarredView" ],
        "summary" : "Get Starred Views",
        "description" : "This API lists the starred views in a module. Number of resources in the starred view is displayed only for the Tickets module.",
        "operationId" : "getStarredViews",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "module",
          "in" : "query",
          "description" : "Module associated with the view. Possible values: tickets, tasks, contacts, accounts, calls, events, activities, contracts",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "tickets", "tasks", "contacts", "accounts", "calls", "events", "activities", "contracts" ],
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s]+"
          }
        }, {
          "name" : "departmentId",
          "in" : "query",
          "description" : "Unique ID of the department in which the view is configured",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]*|null|undefined)"
          }
        }, {
          "name" : "featureFlags",
          "in" : "header",
          "required" : false,
          "description" : "Optional flags to include extra details in the response. Possible values: createdBy. Use a comma-separated list to pass more than one.",
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "createdBy" ]
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/getStarredViewsResponse"
          },
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.basic.READ", "Desk.settings.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "starredView_array" : {
        "type" : [ "array" ],
        "items" : {
          "type" : [ "string", "integer" ],
          "format" : "int64",
          "pattern" : "([0-9]+)"
        }
      },
      "starredViewResponseArray" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/starredViewsJson"
        }
      },
      "starredViewsJson" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "id" : {
            "description" : "Unique ID of the view",
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "name" : {
            "description" : "Name of the view",
            "type" : [ "string", "null" ],
            "maxLength" : 50,
            "minLength" : 0,
            "pattern" : "[0-9a-zA-Z_\\-\\.\\$@%\\?\\,\\:\\'\\P{InBasicLatin}\\s&amp;&lt;&gt;\\+=]+"
          },
          "viewName" : {
            "description" : "Name of the view",
            "type" : [ "string", "null" ],
            "maxLength" : 50,
            "minLength" : 0
          },
          "isCustomView" : {
            "description" : "Indicates whether the view is a custom view. Possible values: true = custom view, false = system view",
            "type" : [ "boolean", "null" ]
          },
          "isLocked" : {
            "description" : "Indicates whether the custom view is locked. Possible values: true = locked, false = not locked",
            "type" : [ "boolean", "null" ]
          },
          "deprecatedViewId" : {
            "description" : "Deprecated ID of the view",
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "count" : {
            "description" : "Number of resources in the starred view",
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "createdBy" : {
            "description" : "ID of the user who created the view",
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        },
        "required" : [ "id", "name", "viewName", "isCustomView", "isLocked", "deprecatedViewId" ]
      }
    },
