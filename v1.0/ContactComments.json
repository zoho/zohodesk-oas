          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : "string",
            "enum" : [ "commentedTime" ],
            "pattern" : "-?(commentedTime)"
          }
        }, {
          "name" : "contactId",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
