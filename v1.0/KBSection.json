    "/api/v1/kbSections/{sectionId}" : {
      "get" : {
        "tags" : [ "KBSection" ],
        "summary" : "Get a KB section",
        "description" : "This API fetches a section in your helpdesk",
        "operationId" : "getKBSection",
        "x-mcp-group" : [ "KB Admin", "KB Dashboard", "Manage KB Category", "View KB Category", "Manage KB Moderation", "View KB Moderation", "Manage KB Recyclebin", "View KB Recyclebin", "Manage KB Templates", "View KB Templates", "Manage KB Articles", "View KB Articles", "Manage KB Feedbacks", "View KB Feedbacks", "View KB" ],
        "parameters" : [ {
          "name" : "sectionId",
          "in" : "path",
          "description" : "Unique ID of the section",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
