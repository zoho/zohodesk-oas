              "properties" : {
                "data" : {
                  "$ref" : "#/components/schemas/actorResponseArray"
                }
              },
              "required" : [ "data" ]
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "data" : [ {
                    "photoURL" : "https://desk.example.com/api/v1/agents/1892000000056007/photo?orgId=1234567890",
                    "firstName" : "Steve",
                    "lastName" : "Watson",
                    "id" : "1892000000056007",
                    "type" : "AGENT"
                  }, {
                    "photoURL" : "https://desk.example.com/api/v1/agents/1892000000042001/photo?orgId=1234567890",
                    "firstName" : "",
                    "lastName" : "jade",
                    "id" : "1892000000042001",
                    "type" : "AGENT"
                  }, {
