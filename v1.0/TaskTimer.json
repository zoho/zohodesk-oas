{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "TaskTimer",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/tasks/{taskId}/timer" : {
      "get" : {
        "tags" : [ "TaskTimer" ],
        "summary" : "Get Task Timer",
        "description" : "Retrieves the time elapsed in the task timer, along with its current state.",
        "operationId" : "getTaskTimer",
        "x-mcp-group" : [ "Time Tracking", "Tasks" ],
        "parameters" : [ {
          "name" : "taskId",
          "in" : "path",
          "description" : "Unique ID of the task from which the timer must be retrieved",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/taskTimerJson"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.activities.tasks.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.tasks.READ" ]
        } ]
      },
      "post" : {
        "tags" : [ "TaskTimer" ],
        "summary" : "Perform Task Timer Action",
        "description" : "Performs a timer-related action on a task.",
        "operationId" : "updateTaskTimerState",
        "x-mcp-group" : [ "Time Tracking", "Tasks" ],
        "parameters" : [ {
          "name" : "action",
          "in" : "query",
          "description" : "Action to perform on the timer. Possible values: START, STOP, PAUSE, RESUME",
          "required" : true,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "START", "STOP", "PAUSE", "RESUME" ]
          }
        }, {
          "name" : "taskId",
          "in" : "path",
          "description" : "Unique ID of the task containing the timer",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/multipleUnprocessEntityResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/taskTimerJson"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.activities.tasks.UPDATE" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.tasks.UPDATE" ]
        } ]
      }
    },
    "/api/v1/tasks/{entityId}/activeTimer" : {
      "get" : {
        "tags" : [ "TaskTimer" ],
        "summary" : "Get Task Timers",
        "description" : "Retrieves the details of timers currently active in a specific task, with pagination support.",
        "operationId" : "getActiveTimersForTask",
        "x-mcp-group" : [ "Time Tracking", "Tasks" ],
        "parameters" : [ {
          "name" : "include",
          "in" : "query",
          "description" : "Additional information to include in the response. Possible values: owner",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "string" ],
            "enum" : [ "owner" ],
            "pattern" : "(owner)"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of timers to fetch. Defaults to 20 if not provided.",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "minimum" : 1,
            "maximum" : 100
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Index number from which timers must be fetched",
          "required" : false,
          "style" : "form",
          "explode" : true,
          "schema" : {
            "type" : [ "integer" ],
            "format" : "int32",
            "pattern" : "([0-9]+)",
            "default" : 0
          }
        }, {
          "name" : "entityId",
          "in" : "path",
          "description" : "Unique ID of the task",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/getActiveTimerForEntity"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.activities.tasks.READ" ]
        }, {
          "deprecated-iam-oauth2-schema" : [ "Desk.tasks.READ" ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "taskTimerJson" : {
        "description" : "Timer details associated with the active timer entry",
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "hours" : {
            "description" : "Number of hours spent by the agent",
            "type" : [ "string", "integer", "null" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          },
          "seconds" : {
            "description" : "Number of seconds spent by the agent",
            "type" : [ "string", "integer", "null" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          },
          "minutes" : {
            "description" : "Number of minutes spent by the agent",
            "type" : [ "string", "integer", "null" ],
            "format" : "int32",
            "pattern" : "([0-9]+)"
          },
          "state" : {
            "description" : "Current state of the timer. Possible values: RUNNING, PAUSED, INIT",
            "type" : [ "string", "null" ],
            "enum" : [ "RUNNING", "PAUSED", "INIT" ]
          }
        },
        "required" : [ "hours", "minutes", "seconds", "state" ]
      },
      "activeTimerJson" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "timer" : {
            "$ref" : "#/components/schemas/taskTimerJson"
          },
          "userId" : {
            "description" : "Unique ID of the agent whose timer is active",
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          },
          "owner" : {
            "description" : "Details of the agent who owns the timer. Returned when include=owner is passed.",
            "type" : [ "object", "null" ],
            "additionalProperties" : false,
            "maxProperties" : 5,
            "minProperties" : 5,
            "properties" : {
              "photoURL" : {
                "description" : "URL of the owner's profile photo",
                "type" : [ "string", "null" ],
                "maxLength" : 100,
                "minLength" : 0,
                "pattern" : "([0-9a-zA-Z_\\-\\.\\$@\\?\\,\\:\\'\\/\\!\\P{InBasicLatin}\\s])+"
              },
              "firstName" : {
                "description" : "First name of the owner",
                "type" : [ "string", "null" ],
                "maxLength" : 50,
                "minLength" : 0
              },
              "lastName" : {
                "description" : "Last name of the owner",
                "type" : [ "string", "null" ],
                "maxLength" : 50,
                "minLength" : 0
              },
              "name" : {
                "description" : "Full name of the owner",
                "type" : [ "string", "null" ],
                "maxLength" : 50,
                "minLength" : 0
              },
              "id" : {
                "description" : "Unique ID of the owner",
                "type" : [ "string", "integer", "null" ],
                "format" : "int64",
                "pattern" : "([0-9]+)"
              }
            },
            "required" : [ "firstName", "id", "lastName", "name", "photoURL" ]
          }
        },
        "required" : [ "timer", "userId" ]
      },
      "data" : {
        "description" : "List of active timer entries",
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/activeTimerJson"
        }
      }
    },
    "responses" : {
      "taskTimerJson" : {
        "description" : "taskTimerJson template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "$ref" : "#/components/schemas/taskTimerJson"
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "hours" : 0,
                  "seconds" : 0,
                  "minutes" : 0,
                  "state" : "RUNNING"
                }
              }
            }
          }
        }
      },
      "getActiveTimerForEntity" : {
        "description" : "getActiveTimerForEntity template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object", "null" ],
              "additionalProperties" : false,
              "properties" : {
                "data" : {
                  "$ref" : "#/components/schemas/data"
                }
              },
              "required" : [ "data" ]
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "data" : [ {
                    "owner" : {
                      "firstName" : "Sam",
                      "lastName" : "Jones",
                      "photoURL" : "https://contacts.zoho.com/file?t=user&fs=thumb&ID=56934690&nps=404&exp=20",
                      "name" : "Sam Jones",
                      "id" : "7000000020001"
                    },
                    "timer" : {
                      "hours" : 93,
                      "seconds" : 9,
                      "minutes" : 6,
                      "state" : "RUNNING"
                    },
                    "userId" : "7000000020001"
                  }, {
                    "owner" : {
                      "firstName" : "Robert",
                      "lastName" : "Downey",
                      "photoURL" : "https://contacts.zoho.com/file?t=user&fs=thumb&ID=56934690&nps=404&exp=20",
                      "name" : "Robert Downey",
                      "id" : "7000000030001"
                    },
                    "timer" : {
                      "hours" : 19,
                      "seconds" : 24,
                      "minutes" : 9,
                      "state" : "PAUSED"
                    },
                    "userId" : "7000000030001"
                  } ]
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "cookie-auth" : {
        "$ref" : "./Common.json#/components/securitySchemes/cookie-auth"
      },
      "org-oauth" : {
        "$ref" : "./Common.json#/components/securitySchemes/org-oauth"
      },
      "iam-oauth2-schema" : {
        "$ref" : "./Common.json#/components/securitySchemes/iam-oauth2-schema"
      },
      "deprecated-iam-oauth2-schema" : {
        "$ref" : "./Common.json#/components/securitySchemes/deprecated-iam-oauth2-schema"
      }
    }
  },
  "x-entity" : "TaskTimer"
}