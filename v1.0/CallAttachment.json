{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "CallAttachment",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/calls/{callId}/attachments" : {
      "post" : {
        "tags" : [ "CallAttachment" ],
        "summary" : "Create call attachment",
        "description" : "This API attaches a file to a call.",
        "operationId" : "createCallAttachment",
        "parameters" : [ {
          "name" : "callId",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "null", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary",
                    "description" : "The file to attach to the call"
                  }
                },
                "required" : [ "file" ]
              }
            }
          }
        },
        "responses" : {
          "422" : {
            "$ref" : "./Common.json#/components/responses/invalidDataErrorResponse"
          },
          "200" : {
            "$ref" : "#/components/responses/attachmentResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.activities.calls.UPDATE", "Desk.tasks.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    },
    "/api/v1/calls/{callId}/attachments/{attachmentId}" : {
      "delete" : {
        "tags" : [ "CallAttachment" ],
        "summary" : "Delete call attachment",
        "description" : "This API deletes an attachment from a call.",
        "operationId" : "deleteCallAttachment",
        "parameters" : [ {
          "name" : "callId",
          "in" : "path",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "null", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "attachmentId",
          "in" : "path",
          "description" : "ID of the attachment associated with the call",
          "required" : true,
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "null", "integer" ],
            "format" : "int64",
            "description" : "ID of the attachment associated with the call",
            "pattern" : "([0-9]+)"
          }
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "204" : {
            "$ref" : "./Common.json#/components/responses/emptyResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.activities.calls.UPDATE", "Desk.tasks.UPDATE" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
