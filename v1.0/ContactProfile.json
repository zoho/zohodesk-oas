{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "ContactProfile",
    "version" : "1.0.0"
  },
  "paths" : {
    "/api/v1/contacts/{contactId}/profiles" : {
      "get" : {
        "tags" : [ "ContactProfile" ],
        "summary" : "Get Contact Profiles",
        "description" : "This api fetches the list of profiles of this contact from various channels.",
        "operationId" : "getContactProfiles",
        "x-mcp-ready" : true,
        "parameters" : [ {
          "name" : "contactId",
          "in" : "path",
          "required" : true,
          "description" : "Unique ID of the contact",
          "style" : "simple",
          "explode" : false,
          "schema" : {
            "type" : [ "string", "integer" ],
            "format" : "int64",
            "pattern" : "([0-9]+)"
          }
        }, {
          "name" : "include",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : [ "array" ],
            "items" : {
              "type" : [ "string" ],
              "enum" : [ "source" ],
              "description" : "Accepted values: source"
            }
          },
          "style" : "form",
          "explode" : false,
          "description" : "Additional information related to the profile's channel. Values allowed are: source"
        }, {
          "$ref" : "./Common.json#/components/parameters/orgId"
        } ],
        "responses" : {
          "200" : {
            "$ref" : "#/components/responses/getContactProfilesResponse"
          }
        },
        "security" : [ {
          "iam-oauth2-schema" : [ "Desk.contacts.READ" ]
        } ],
        "x-audience" : [ "external-public" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "source" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "appName" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "Name of the channel application"
          },
          "permalink" : {
            "type" : [ "string", "null" ],
            "maxLength" : 65535,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)",
            "description" : "Permalink URL of the profile in the channel application"
          },
          "appPhotoURL" : {
            "type" : [ "string", "null" ],
            "maxLength" : 65535,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)",
            "description" : "URL of the channel application's photo"
          }
        },
        "required" : [ "appName", "appPhotoURL", "permalink" ]
      },
      "getContactProfileResponse" : {
        "type" : [ "object", "null" ],
        "additionalProperties" : false,
        "properties" : {
          "photoURL" : {
            "type" : [ "string", "null" ],
            "maxLength" : 65535,
            "minLength" : 0,
            "pattern" : "(^(ht|f)tp(s?)\\://[-.\\w]*(/?)([a-zA-Z0-9\\-\\.\\?\\,\\:\\'/\\\\+=&amp;%\\$#_@]*)?$)",
            "description" : "URL of the contact's profile photo in the channel"
          },
          "displayName" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "Display name of the contact in the channel"
          },
          "name" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "description" : "Name of the contact in the channel"
          },
          "channel" : {
            "type" : [ "string", "null" ],
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "([a-zA-Z0-9_\\-]+)",
            "description" : "Channel through which the contact profile is associated"
          },
          "id" : {
            "type" : [ "string", "integer", "null" ],
            "format" : "int64",
            "pattern" : "([0-9]+)",
            "description" : "Unique ID of the contact profile in the channel"
          },
          "source" : {
            "$ref" : "#/components/schemas/source"
          }
        },
        "required" : [ "channel", "displayName", "id", "name", "photoURL", "source" ]
      },
      "getContactProfilesArray" : {
        "type" : [ "array", "null" ],
        "items" : {
          "$ref" : "#/components/schemas/getContactProfileResponse"
        }
      }
    },
    "responses" : {
      "getContactProfilesResponse" : {
        "description" : "getContactProfilesResponse template definitions",
        "content" : {
          "application/json" : {
            "schema" : {
              "type" : [ "object", "null" ],
              "additionalProperties" : false,
              "properties" : {
                "data" : {
                  "$ref" : "#/components/schemas/getContactProfilesArray"
                }
              },
              "required" : [ "data" ]
            },
            "examples" : {
              "Valid responses Definitions" : {
                "value" : {
                  "data" : [ {
                    "photoURL" : "https://www.youtube.com/user/iwe3in2/photo",
                    "displayName" : "Jade Vlogs",
                    "name" : "Jade Zylker",
                    "channel" : "YOUTUBE",
                    "id" : "3923923923",
                    "source" : {
                      "appName" : "Youtube Sync App",
                      "permalink" : "https://www.examplechannel.com/apps/redirect.php?entity=profile&id=3290dweiod",
                      "appPhotoURL" : "https://desk.example.com/api/v1/channels/youtube/photo?orgId=1234567890"
                    }
                  }, {
                    "photoURL" : "https://www.intagram.com/johninsta/photo",
                    "displayName" : "John Insta",
                    "name" : "John Zylker",
                    "channel" : "INSTAGRAM",
                    "id" : "3923923924",
                    "source" : {
                      "appName" : "Instagram Syncing App",
                      "permalink" : "https://www.examplechannel.com/apps/redirect.php?entity=profile&id=3290dweiod",
                      "appPhotoURL" : "https://desk.example.com/api/v1/channels/instagram/photo?orgId=1234567890"
                    }
                  } ]
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "cookie-auth" : {
        "$ref" : "./Common.json#/components/securitySchemes/cookie-auth"
      },
      "org-oauth" : {
        "$ref" : "./Common.json#/components/securitySchemes/org-oauth"
      },
      "iam-oauth2-schema" : {
        "$ref" : "./Common.json#/components/securitySchemes/iam-oauth2-schema"
      }
    }
  },
  "x-entity" : "ContactProfile"
}